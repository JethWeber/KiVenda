<Project Sdk="Microsoft.NET.Sdk">

  <!--
    KiVenda.Desktop
    Camada de topo: interface gráfica em Avalonia 11 com MVVM
    (CommunityToolkit.Mvvm). É o único projeto "executável" da solução
    e o composition root da aplicação (DI + logging).
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.10" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.10" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.10" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.10" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.10" Condition="'$(Configuration)' == 'Debug'" />

    <!-- LiveCharts2 - compatível com Avalonia 11.3.x (reservado para gráficos futuros, ex.: Fase 9) -->
    <PackageReference Include="LiveChartsCore.SkiaSharpView.Avalonia" Version="2.0.5" />

    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />

    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />

    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />

    <!--
      Overrides de segurança para dependências transitivas vulneráveis:
      - SQLitePCLRaw.lib.e_sqlite3 2.1.10 (via EF Core Sqlite, consumido
        através de KiVenda.Persistence): CVE-2025-6965 / GHSA-2m69-gcr7-jv3q.
      - Tmds.DBus.Protocol 0.20.0 (via Avalonia, integração D-Bus no
        Linux — clipboard/notificações): GHSA-xrw6-gwf8-vvr9.
      Ver README, secção "Correção Pós-Fase 3".
    -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KiVenda.Core\KiVenda.Core.csproj" />
    <ProjectReference Include="..\KiVenda.Application\KiVenda.Application.csproj" />
    <ProjectReference Include="..\KiVenda.Infrastructure\KiVenda.Infrastructure.csproj" />
    <ProjectReference Include="..\KiVenda.Persistence\KiVenda.Persistence.csproj" />
  </ItemGroup>

</Project>
