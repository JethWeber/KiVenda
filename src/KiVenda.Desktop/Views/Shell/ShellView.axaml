<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:KiVenda.Desktop.ViewModels.Shell" xmlns:vmc="using:KiVenda.Desktop.ViewModels.Common" xmlns:vmm="using:KiVenda.Desktop.ViewModels.Modulos" xmlns:views="using:KiVenda.Desktop.Views.Modulos" x:Class="KiVenda.Desktop.Views.Shell.ShellView" x:DataType="vm:ShellViewModel">
<UserControl.DataTemplates>
<DataTemplate DataType="vmm:DashboardViewModel"><views:DashboardView/></DataTemplate><DataTemplate DataType="vmm:VendasViewModel"><views:VendasView/></DataTemplate><DataTemplate DataType="vmm:CaixaViewModel"><views:CaixaView/></DataTemplate><DataTemplate DataType="vmm:ProdutosViewModel"><views:ProdutosView/></DataTemplate><DataTemplate DataType="vmm:CadastrosViewModel"><views:CadastrosView/></DataTemplate><DataTemplate DataType="vmm:ComprasViewModel"><views:ComprasView/></DataTemplate><DataTemplate DataType="vmm:UtilizadoresViewModel"><views:UtilizadoresView/></DataTemplate><DataTemplate DataType="vmm:RelatoriosViewModel"><views:RelatoriosView/></DataTemplate><DataTemplate DataType="vmm:AuditoriaViewModel"><views:AuditoriaView/></DataTemplate><DataTemplate DataType="vmm:ConfiguracoesViewModel"><views:ConfiguracoesView/></DataTemplate><DataTemplate DataType="vmm:EmBreveViewModel"><views:EmBreveView/></DataTemplate>
</UserControl.DataTemplates>
<Grid ColumnDefinitions="250,*" Background="{DynamicResource FundoPaginaBrush}">
<Border Grid.Column="0" Background="{DynamicResource SuperficieBrush}" BorderBrush="{DynamicResource BordaBrush}" BorderThickness="0,0,1,0"><Grid RowDefinitions="Auto,*,Auto"><StackPanel Grid.Row="0" Margin="20,24,20,18" Spacing="3"><TextBlock Text="KiVenda" FontWeight="Bold" FontSize="22" Foreground="{DynamicResource VerdePrimarioBrush}"/><TextBlock Text="Quem vende, controla." FontSize="10" Foreground="{DynamicResource TextoSecundarioBrush}"/></StackPanel>
<ListBox Grid.Row="1" Margin="12,0" Background="Transparent" BorderThickness="0" ItemsSource="{Binding ItensMenu}" SelectionChanged="OnMenuSelectionChanged"><ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="Padding" Value="14,11"/><Setter Property="CornerRadius" Value="9"/><Setter Property="Margin" Value="0,2"/></Style><Style Selector="ListBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource VerdeSuaveBrush}"/></Style><Style Selector="ListBoxItem:selected TextBlock"><Setter Property="Foreground" Value="{DynamicResource VerdePrimarioBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Style></ListBox.Styles><ListBox.ItemTemplate><DataTemplate DataType="vmc:ItemMenuLateral"><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="{Binding Icone}" FontSize="16" Width="22"/><TextBlock Text="{Binding Nome}" FontSize="14" VerticalAlignment="Center"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
<StackPanel Grid.Row="2" Margin="12,0,12,14"><Border Height="1" Background="{DynamicResource BordaBrush}" Margin="4,0,4,8"/><ItemsControl ItemsSource="{Binding ItensMenuInferiores}"><ItemsControl.ItemTemplate><DataTemplate DataType="vmc:ItemMenuLateral"><Button Command="{Binding $parent[UserControl].DataContext.SelecionarItemCommand}" CommandParameter="{Binding}" Classes="secundario" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Padding="14,11" Margin="0,2"><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="{Binding Icone}" FontSize="16" Width="22"/><TextBlock Text="{Binding Nome}" FontSize="14"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
</Grid></Border>
<Grid Grid.Column="1" RowDefinitions="Auto,*"><Border Grid.Row="0" Background="{DynamicResource SuperficieBrush}" BorderBrush="{DynamicResource BordaBrush}" BorderThickness="0,0,0,1" Padding="24,14"><Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto"><TextBlock Text="{Binding NomeEmpresa}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextoPrimarioBrush}"/><Button Grid.Column="1" Command="{Binding AbrirNotificacoesCommand}" Content="🔔" Background="Transparent" BorderThickness="0" Width="44" Height="44"/><Button Grid.Column="2" Command="{Binding AlternarTemaCommand}" Content="{Binding TemaBotaoTexto}" Background="Transparent" BorderThickness="0" Width="40" Height="40"/><StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,10,0"><TextBlock Text="{Binding NomeUtilizador}" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="{Binding PerfilTexto}" FontSize="10" Foreground="{DynamicResource TextoSecundarioBrush}"/></StackPanel><Button Grid.Column="4" Content="{Binding IniciaisNome}" Background="{DynamicResource VerdeSuaveBrush}" BorderThickness="0" Width="42" Height="42"/></Grid></Border>
<ScrollViewer Grid.Row="1" Padding="24" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ContentControl Content="{Binding ConteudoAtual}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"/></ScrollViewer></Grid></Grid></UserControl>