<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KiVenda.Desktop.ViewModels.Shell"
             xmlns:vmc="using:KiVenda.Desktop.ViewModels.Common"
             xmlns:vmm="using:KiVenda.Desktop.ViewModels.Modulos"
             xmlns:views="using:KiVenda.Desktop.Views.Modulos"
             x:Class="KiVenda.Desktop.Views.Shell.ShellView"
             x:DataType="vm:ShellViewModel">

    <UserControl.DataTemplates>
        <DataTemplate DataType="vmm:DashboardViewModel">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="vmm:VendasViewModel">
            <views:VendasView />
        </DataTemplate>
        <DataTemplate DataType="vmm:CaixaViewModel">
            <views:CaixaView />
        </DataTemplate>
        <DataTemplate DataType="vmm:ProdutosViewModel">
            <views:ProdutosView />
        </DataTemplate>
        <DataTemplate DataType="vmm:ClientesViewModel">
            <views:ClientesView />
        </DataTemplate>
        <DataTemplate DataType="vmm:FornecedoresViewModel">
            <views:FornecedoresView />
        </DataTemplate>
        <DataTemplate DataType="vmm:ComprasViewModel">
            <views:ComprasView />
        </DataTemplate>
        <DataTemplate DataType="vmm:UtilizadoresViewModel">
            <views:UtilizadoresView />
        </DataTemplate>
        <DataTemplate DataType="vmm:EmBreveViewModel">
            <views:EmBreveView />
        </DataTemplate>
    </UserControl.DataTemplates>

    <Grid ColumnDefinitions="260,*" Background="{StaticResource FundoPaginaBrush}">

        <!-- ===================== Sidebar ===================== -->
        <Border Grid.Column="0"
                Background="{StaticResource SuperficieBrush}"
                BorderBrush="{StaticResource BordaBrush}"
                BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*,Auto">

                <!-- Logótipo -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="20,24,20,16">
                    <Border Background="{StaticResource VerdePrimarioBrush}" CornerRadius="10" Width="40" Height="40">
                        <TextBlock Text="K" Foreground="White" FontWeight="Bold" FontSize="18"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="KiVenda" FontWeight="Bold" FontSize="18" Foreground="{StaticResource VerdePrimarioBrush}" />
                        <TextBlock Text="Angolan ERP" FontSize="11" Foreground="{StaticResource TextoSecundarioBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Menu: estilos locais (aplicam-se só a este ListBox,
                     sem depender de classes globais) -->
                <ListBox Grid.Row="1"
                         Margin="12,4"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemsSource="{Binding ItensMenu}"
                         SelectedItem="{Binding ItemSelecionado}">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="14,11" />
                            <Setter Property="CornerRadius" Value="10" />
                            <Setter Property="Margin" Value="0,2" />
                        </Style>
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                            <Setter Property="Background" Value="{StaticResource VerdeSuaveBrush}" />
                        </Style>
                        <Style Selector="ListBoxItem:selected TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource VerdePrimarioBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Style>
                        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="{StaticResource NeutroSuaveBrush}" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vmc:ItemMenuLateral">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="{Binding Icone}" FontSize="16" Width="22" />
                                <TextBlock Text="{Binding Nome}" FontSize="14" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Rodapé: utilizador atual -->
                <Border Grid.Row="2" Padding="16" BorderBrush="{StaticResource BordaBrush}" BorderThickness="0,1,0,0">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="{StaticResource VerdeSuaveBrush}">
                            <TextBlock Text="{Binding InicialNome}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource VerdePrimarioBrush}" FontWeight="Bold" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding NomeUtilizador}" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="{Binding PerfilTexto}" FontSize="11" Foreground="{StaticResource TextoSecundarioBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

            </Grid>
        </Border>

        <!-- ===================== Área principal ===================== -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*">

            <!-- Topbar -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="24,20,24,0">
                <TextBox Grid.Column="0" Watermark="Pesquisar transação ou recibo..." MaxWidth="420" HorizontalAlignment="Left" IsReadOnly="True" />
                <Button Grid.Column="1" Content="Terminar sessão" Command="{Binding TerminarSessaoCommand}" Classes="secundario" />
            </Grid>

            <ScrollViewer Grid.Row="1" Padding="24">
                <ContentControl Content="{Binding ConteudoAtual}" />
            </ScrollViewer>

        </Grid>

    </Grid>

</UserControl>
