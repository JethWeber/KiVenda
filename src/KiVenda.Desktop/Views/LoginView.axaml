<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KiVenda.Desktop.ViewModels"
             x:Class="KiVenda.Desktop.Views.LoginView"
             x:DataType="vm:LoginViewModel">

    <Grid Background="{DynamicResource FundoPaginaBrush}">
        <Ellipse Width="520"
                 Height="520"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Top"
                 Margin="0,-260,-180,0"
                 Fill="{DynamicResource VerdePrimarioBrush}"
                 Opacity="0.035" />
        <Ellipse Width="460"
                 Height="460"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Bottom"
                 Margin="-180,0,0,-220"
                 Fill="{DynamicResource AvisoBrush}"
                 Opacity="0.025" />

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Margin="24"
                  MinHeight="680">

                <StackPanel Width="420"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <Border Background="{DynamicResource SuperficieBrush}"
                            BorderBrush="{DynamicResource BordaBrush}"
                            BorderThickness="1"
                            CornerRadius="14"

                        <StackPanel>
                            <StackPanel HorizontalAlignment="Center"
                                        Margin="40,36,40,24"
                                        Spacing="5">
                                <TextBlock Text="KiVenda"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource VerdePrimarioBrush}"
                                           FontSize="32"
                                           FontWeight="Bold"
                                           LetterSpacing="0.2" />

                                <TextBlock Text="Quem vende, controla."
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextoSecundarioBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           LetterSpacing="0.8" />
                            </StackPanel>

                            <StackPanel Margin="40,0,40,36"
                                        Spacing="20">

                                <StackPanel Spacing="7">
                                    <TextBlock Text="Utilizador"
                                               Classes="rotulo-campo"
                                               FontWeight="SemiBold" />

                                    <TextBox Text="{Binding NomeUtilizador}"
                                             Watermark="ex.: gerente"
                                             Height="46"
                                             FontSize="14" />
                                </StackPanel>

                                <StackPanel Spacing="7">
                                    <TextBlock Text="Palavra-passe"
                                               Classes="rotulo-campo"
                                               FontWeight="SemiBold" />

                                    <Grid>
                                        <TextBox Text="{Binding Senha}"
                                                 PasswordChar="{Binding PasswordChar}"
                                                 Watermark="••••••••"
                                                 Height="46"
                                                 FontSize="14"
                                                 Padding="12,10,46,10" />

                                        <Button Command="{Binding AlternarVisibilidadeSenhaCommand}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Width="42"
                                                Height="42"
                                                Padding="0"
                                                Foreground="{DynamicResource TextoSecundarioBrush}"
                                                ToolTip.Tip="Mostrar/ocultar palavra-passe">
                                            <TextBlock Text="◉"
                                                       FontSize="15"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center" />
                                        </Button>
                                    </Grid>
                                </StackPanel>

                                <TextBlock Text="{Binding MensagemErro}"
                                           Classes="erro"
                                           FontSize="12" />

                                <Button Content="Entrar"
                                        Command="{Binding EntrarCommand}"
                                        IsEnabled="{Binding !AEntrar}"
                                        Classes="primario"
                                        Height="46"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        FontSize="14" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="0,22,0,0"
                                HorizontalAlignment="Center"
                                Spacing="5">
                        <TextBlock Text="KiVenda Desktop"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextoSuaveCinzaBrush}"
                                   FontSize="11" />
                        <TextBlock Text="Sistema local • Funciona offline"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextoSuaveCinzaBrush}"
                                   FontSize="10" />
                    </StackPanel>

                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>