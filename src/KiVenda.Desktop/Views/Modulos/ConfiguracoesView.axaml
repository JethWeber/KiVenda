<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KiVenda.Desktop.ViewModels.Modulos"
             xmlns:views="using:KiVenda.Desktop.Views.Modulos"
             x:Class="KiVenda.Desktop.Views.Modulos.ConfiguracoesView"
             x:DataType="vm:ConfiguracoesViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="18" MaxWidth="980">

        <StackPanel Spacing="4">
            <TextBlock Classes="titulo-pagina" Text="Configurações" />
            <TextBlock Classes="subtitulo" Text="Preferências do sistema, scanner, assinatura e proteção dos dados." />
        </StackPanel>
        <TabControl SelectedIndex="{Binding IndiceAbaSelecionada}">
            <TabItem Header="Empresa" IsVisible="{Binding AbasGeraisVisiveis}">
                <views:ConfiguracaoEmpresaView DataContext="{Binding Empresa}" />
            </TabItem>
            <TabItem Header="Dispositivos" IsVisible="{Binding AbasGeraisVisiveis}">
                <StackPanel Spacing="24">
                        <views:ConfiguracaoScannerView DataContext="{Binding Scanner}" />
                        <views:ConfiguracaoImpressoraView DataContext="{Binding Impressora}" />
                    </StackPanel>
            </TabItem>
            <TabItem Header="Licença">
                <views:ConfiguracaoLicencaView DataContext="{Binding Licenca}" />
            </TabItem>
            <TabItem Header="Backup" IsVisible="{Binding AbasGeraisVisiveis}">
                <views:ConfiguracaoBackupView DataContext="{Binding Backup}" />
            </TabItem>
            <TabItem Header="Ajustes" IsVisible="{Binding AbasGeraisVisiveis}">
                <views:ConfiguracaoTemaView DataContext="{Binding Tema}" />
            </TabItem>
        </TabControl>
    
        </StackPanel>
    </ScrollViewer>
</UserControl>
