<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KiVenda.Desktop.ViewModels.Modulos"
             xmlns:views="using:KiVenda.Desktop.Views.Modulos"
             x:Class="KiVenda.Desktop.Views.Modulos.ConfiguracoesView"
             x:DataType="vm:ConfiguracoesViewModel">

    <Border>
        <Grid RowDefinitions="Auto,*,Auto"
              MaxWidth="1240"
              Margin="40,32,40,16">
            <TextBlock Grid.Row="0"
                       Classes="cfg-page-title"
                       Margin="0,0,0,22"
                       Text="Configurações do Sistema" />

            <Grid Grid.Row="1">
                <TabControl x:Name="Abas"
                            Classes="cfg-tabs"
                            SelectedIndex="{Binding IndiceAbaSelecionada}"
                            SelectionChanged="Abas_SelectionChanged">
                    <TabItem IsVisible="{Binding AbasGeraisVisiveis}">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="▣" />
                                <TextBlock Text="Empresa" VerticalAlignment="Center" />
                            </StackPanel>
                        </TabItem.Header>
                        <views:ConfiguracaoEmpresaView DataContext="{Binding Empresa}" />
                    </TabItem>

                    <TabItem IsVisible="{Binding AbasGeraisVisiveis}">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="▤" />
                                <TextBlock Text="Dispositivos" VerticalAlignment="Center" />
                            </StackPanel>
                        </TabItem.Header>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="24" VerticalAlignment="Top">
                            <views:ConfiguracaoScannerView Grid.Column="0"
                                                           VerticalAlignment="Top"
                                                           DataContext="{Binding Scanner}" />
                            <views:ConfiguracaoImpressoraView Grid.Column="1"
                                                              VerticalAlignment="Top"
                                                              DataContext="{Binding Impressora}" />
                        </Grid>
                    </TabItem>

                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="⚿" />
                                <TextBlock Text="Licença" VerticalAlignment="Center" />
                            </StackPanel>
                        </TabItem.Header>
                        <views:ConfiguracaoLicencaView DataContext="{Binding Licenca}" />
                    </TabItem>

                    <TabItem IsVisible="{Binding AbasGeraisVisiveis}">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="▧" />
                                <TextBlock Text="Backup" VerticalAlignment="Center" />
                            </StackPanel>
                        </TabItem.Header>
                        <views:ConfiguracaoBackupView DataContext="{Binding Backup}" />
                    </TabItem>

                    <TabItem IsVisible="{Binding AbasGeraisVisiveis}">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="⚙" />
                                <TextBlock Text="Ajustes" VerticalAlignment="Center" />
                            </StackPanel>
                        </TabItem.Header>
                        <views:ConfiguracaoTemaView DataContext="{Binding Tema}" />
                    </TabItem>
                </TabControl>

                <Button x:Name="GuardarBtn"
                        Classes="primario cfg"
                        Height="52"
                        Padding="26,0"
                        CornerRadius="14"
                        FontSize="14"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Click="Guardar_Click">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="✓" />
                        <TextBlock Text="Guardar alterações" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock x:Name="VersaoText" Classes="cfg-hint" />
                    <Border Width="1" Height="12" Background="#D0D0D0" />
                    <TextBlock Classes="cfg-hint" Text="Backup:" />
                    <TextBlock Classes="cfg-hint"
                               Text="{Binding Backup.UltimoBackup}"
                               MaxWidth="460"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14">
                    <Button x:Name="SuporteLink" Classes="cfg link" Content="Suporte" Click="Suporte_Click" />
                    <Button x:Name="DocumentacaoLink" Classes="cfg link" Content="Documentação" Click="Documentacao_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
