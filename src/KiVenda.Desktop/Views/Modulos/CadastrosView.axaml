<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KiVenda.Desktop.ViewModels.Modulos"
             xmlns:cad="using:KiVenda.Application.Cadastros"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="KiVenda.Desktop.Views.Modulos.CadastrosView"
             x:DataType="vm:CadastrosViewModel">

    <UserControl.Styles>

        <!-- ===== Pílulas de resumo (contagens por entidade) ===== -->
        <Style Selector="Border.pilula-resumo">
            <Setter Property="Background" Value="{DynamicResource SuperficieBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BordaBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="14,8" />
        </Style>

        <!-- ===== Abas em formato de pílula ===== -->
        <Style Selector="TabItem">
            <Setter Property="Padding" Value="4" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.aba-pilula">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,9" />
        </Style>
        <Style Selector="TabItem:selected Border.aba-pilula">
            <Setter Property="Background" Value="{DynamicResource VerdePrimarioBrush}" />
        </Style>
        <Style Selector="TextBlock.aba-rotulo">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextoPrimarioBrush}" />
        </Style>
        <Style Selector="TabItem:selected TextBlock.aba-rotulo">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Border.aba-contador">
            <Setter Property="Background" Value="{DynamicResource NeutroSuaveBrush}" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="7,2" />
        </Style>
        <Style Selector="TabItem:selected Border.aba-contador">
            <Setter Property="Background" Value="#33FFFFFF" />
        </Style>
        <Style Selector="TextBlock.aba-contador-texto">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextoSecundarioBrush}" />
        </Style>
        <Style Selector="TabItem:selected TextBlock.aba-contador-texto">
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- ===== Cartões de indicadores (KPIs) ===== -->
        <Style Selector="Border.kpi">
            <Setter Property="Background" Value="{DynamicResource SuperficieBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BordaBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="BoxShadow" Value="0 1 3 0 #0F000000" />
        </Style>
        <Style Selector="Border.kpi-icone">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{DynamicResource VerdeSuaveBrush}" />
        </Style>
        <Style Selector="ic|FluentIcon.kpi-icone-symbol">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Foreground" Value="{DynamicResource VerdePrimarioBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.kpi-rotulo">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextoSecundarioBrush}" />
            <Setter Property="Margin" Value="0,12,0,2" />
        </Style>
        <Style Selector="TextBlock.kpi-valor">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextoPrimarioBrush}" />
        </Style>
        <Style Selector="TextBlock.kpi-sub">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextoSecundarioBrush}" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <!-- ===== Campo de pesquisa com ícone ===== -->
        <Style Selector="Border.campo-busca">
            <Setter Property="Background" Value="{DynamicResource FundoPaginaBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BordaBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Border.campo-busca TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- ===== Avatares com iniciais (sem fotografias) ===== -->
        <Style Selector="Border.avatar">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Background" Value="{DynamicResource VerdeSuaveBrush}" />
        </Style>
        <Style Selector="Border.avatar TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource VerdePrimarioBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.avatar-info">
            <Setter Property="Background" Value="{DynamicResource InfoSuaveBrush}" />
        </Style>
        <Style Selector="Border.avatar-info TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource InfoBrush}" />
        </Style>

        <!-- ===== Tabela ===== -->
        <Style Selector="Border.cabecalho-tabela">
            <Setter Property="Background" Value="{DynamicResource NeutroSuaveBrush}" />
        </Style>
        <Style Selector="Border.cabecalho-tabela TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextoSecundarioBrush}" />
        </Style>
        <Style Selector="Border.linha-tabela:pointerover">
            <Setter Property="Background" Value="{DynamicResource NeutroSuaveBrush}" />
        </Style>
        <Style Selector="Button.acao-icone">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource NeutroSuaveBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextoSecundarioBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.acao-icone.perigo">
            <Setter Property="Background" Value="{DynamicResource PerigoSuaveBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PerigoBrush}" />
        </Style>

    </UserControl.Styles>

    <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="18">

            <!-- ===================== Cabeçalho ===================== -->
            <StackPanel Spacing="4">
                <TextBlock Text="MÓDULO DE CADASTROS" FontSize="11" FontWeight="Bold"
                           Foreground="{DynamicResource VerdePrimarioBrush}" />
                <TextBlock Classes="titulo-pagina" Text="Central de Cadastros" />
                <TextBlock Classes="subtitulo" Text="Clientes, fornecedores e funcionários num único espaço." />
            </StackPanel>

            <TextBlock Classes="erro" Text="{Binding MensagemErro}"
                       IsVisible="{Binding MensagemErro, Converter={x:Static ObjectConverters.IsNotNull}}" />

            <!-- ===================== Abas ===================== -->
            <TabControl SelectedIndex="{Binding AbaSelecionada}">

                <!-- ============================================================ -->
                <!-- CLIENTES                                                      -->
                <!-- ============================================================ -->
                <TabItem>
                    <TabItem.Header>
                        <Border Classes="aba-pilula">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Classes="aba-rotulo" Text="Clientes" />
                                
                            </StackPanel>
                        </Border>
                    </TabItem.Header>

                    <StackPanel Spacing="18">

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="2">
                            <Border Classes="campo-busca">
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Text="⌕" FontSize="15" Margin="12,0,2,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextoSecundarioBrush}" />
                                    <TextBox Grid.Column="1" Text="{Binding PesquisaClientes}"
                                             Watermark="Pesquisar por nome, telefone ou NIF..." />
                                </Grid>
                            </Border>
                            <Button Grid.Column="1" Classes="primario" Command="{Binding NovoClienteCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="+" FontWeight="Bold" />
                                    <TextBlock Text="Novo Cliente" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Border Classes="cartao" Padding="0">
                            <StackPanel>
                                <Border Classes="cabecalho-tabela">
                                    <Grid ColumnDefinitions="48,2*,1.2*,1.4*,1.2*,Auto" Margin="16,12">
                                        <TextBlock Grid.Column="1" Text="CLIENTE" />
                                        <TextBlock Grid.Column="2" Text="CONTACTO" />
                                        <TextBlock Grid.Column="3" Text="EMAIL" />
                                        <TextBlock Grid.Column="4" Text="NIF" />
                                        <TextBlock Grid.Column="5" Text="AÇÕES" />
                                    </Grid>
                                </Border>
                                <ItemsControl ItemsSource="{Binding Clientes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="cad:ClienteCadastroDto">
                                            <Border Classes="linha-tabela" BorderBrush="{DynamicResource BordaBrush}"
                                                    BorderThickness="0,0,0,1" Padding="16,12">
                                                <Grid ColumnDefinitions="48,2*,1.2*,1.4*,1.2*,Auto">
                                                    <Border Classes="avatar">
                                                        <TextBlock Text="{Binding Nome, Converter={StaticResource IniciaisConverter}}" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding Nome}"
                                                               FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Telefone}"
                                                               Foreground="{DynamicResource TextoSecundarioBrush}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="3" Text="{Binding Email}"
                                                               Foreground="{DynamicResource TextoSecundarioBrush}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="4" Text="{Binding Nif}"
                                                               Foreground="{DynamicResource TextoSecundarioBrush}"
                                                               VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6">
                                                        <Button Classes="acao-icone" Content="✎"
                                                                Command="{Binding $parent[UserControl].DataContext.EditarClienteCommand}"
                                                                CommandParameter="{Binding}" />
                                                        <Button Classes="acao-icone perigo" Content="×"
                                                                Command="{Binding $parent[UserControl].DataContext.EliminarClienteCommand}"
                                                                CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>

                <!-- ============================================================ -->
                <!-- FORNECEDORES                                                  -->
                <!-- ============================================================ -->
                <TabItem>
                    <TabItem.Header>
                        <Border Classes="aba-pilula">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Classes="aba-rotulo" Text="Fornecedores" />
                                
                            </StackPanel>
                        </Border>
                    </TabItem.Header>

                    <StackPanel Spacing="18">

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="2">
                            <Border Classes="campo-busca">
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Text="⌕" FontSize="15" Margin="12,0,2,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextoSecundarioBrush}" />
                                    <TextBox Grid.Column="1" Text="{Binding PesquisaFornecedores}"
                                             Watermark="Pesquisar por fornecedor, NIF ou contacto..." />
                                </Grid>
                            </Border>
                            <Button Grid.Column="1" Classes="primario" Command="{Binding NovoFornecedorCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="+" FontWeight="Bold" />
                                    <TextBlock Text="Novo Fornecedor" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Border Classes="cartao" Padding="0">
                            <StackPanel>
                                <Border Classes="cabecalho-tabela">
                                    <Grid ColumnDefinitions="48,1.6*,1.1*,1.3*,1.1*,1.6*,Auto" Margin="16,12">
                                        <TextBlock Grid.Column="1" Text="FORNECEDOR" />
                                        <TextBlock Grid.Column="2" Text="CONTACTO" />
                                        <TextBlock Grid.Column="3" Text="EMAIL" />
                                        <TextBlock Grid.Column="4" Text="NIF" />
                                        <TextBlock Grid.Column="5" Text="PRODUTOS FORNECIDOS" />
                                        <TextBlock Grid.Column="6" Text="AÇÕES" />
                                    </Grid>
                                </Border>
                                <ItemsControl ItemsSource="{Binding Fornecedores}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="cad:FornecedorCadastroDto">
                                            <Border Classes="linha-tabela" BorderBrush="{DynamicResource BordaBrush}"
                                                    BorderThickness="0,0,0,1" Padding="16,12">
                                                <Grid ColumnDefinitions="48,1.6*,1.1*,1.3*,1.1*,1.6*,Auto">
                                                    <Border Classes="avatar avatar-info">
                                                        <TextBlock Text="{Binding Nome, Converter={StaticResource IniciaisConverter}}" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding Nome}"
                                                               FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Telefone}"
                                                               Foreground="{DynamicResource TextoSecundarioBrush}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="3" Text="{Binding Email}"
                                                               Foreground="{DynamicResource TextoSecundarioBrush}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="4" Text="{Binding Nif}"
                                                               Foreground="{DynamicResource TextoSecundarioBrush}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="5" Text="{Binding ProdutosFornecidos}"
                                                               TextWrapping="Wrap"
                                                               Foreground="{DynamicResource TextoSecundarioBrush}"
                                                               VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="6">
                                                        <Button Classes="acao-icone" Content="✎"
                                                                Command="{Binding $parent[UserControl].DataContext.EditarFornecedorCommand}"
                                                                CommandParameter="{Binding}" />
                                                        <Button Classes="acao-icone perigo" Content="×"
                                                                Command="{Binding $parent[UserControl].DataContext.EliminarFornecedorCommand}"
                                                                CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>

                <!-- ============================================================ -->
                <!-- FUNCIONÁRIOS                                                  -->
                <!-- ============================================================ -->
                <TabItem>
                    <TabItem.Header>
                        <Border Classes="aba-pilula">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Classes="aba-rotulo" Text="Funcionários" />
                                
                            </StackPanel>
                        </Border>
                    </TabItem.Header>

                    <StackPanel Spacing="18">

                        <UniformGrid Columns="4" Rows="1">
                            <Border Classes="kpi" Margin="0,0,7,0">
                                <StackPanel>
                                    <Border Classes="kpi-icone"><ic:FluentIcon Classes="kpi-icone-symbol" Icon="People" IconVariant="Regular" IconSize="Size20" /></Border>
                                    <TextBlock Classes="kpi-rotulo" Text="Total de Funcionários" />
                                    <TextBlock Classes="kpi-valor" Text="{Binding TotalFuncionariosTexto}" />
                                    <TextBlock Classes="kpi-sub" Text="Registados no sistema" />
                                </StackPanel>
                            </Border>
                            <Border Classes="kpi" Margin="7,0">
                                <StackPanel>
                                    <Border Classes="kpi-icone"><ic:FluentIcon Classes="kpi-icone-symbol" Icon="PersonAvailable" IconVariant="Regular" IconSize="Size20" /></Border>
                                    <TextBlock Classes="kpi-rotulo" Text="Funcionários Ativos" />
                                    <TextBlock Classes="kpi-valor" Text="{Binding FuncionariosAtivosTexto}" />
                                    <TextBlock Classes="kpi-sub">
                                        <Run Text="{Binding FuncionariosInativosTexto}" />
                                        <Run Text=" inativo(s)" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Classes="kpi" Margin="7,0">
                                <StackPanel>
                                    <Border Classes="kpi-icone"><ic:FluentIcon Classes="kpi-icone-symbol" Icon="Money" IconVariant="Regular" IconSize="Size20" /></Border>
                                    <TextBlock Classes="kpi-rotulo" Text="Massa Salarial" />
                                    <TextBlock Classes="kpi-valor" Text="{Binding MassaSalarialTexto}" />
                                    <TextBlock Classes="kpi-sub" Text="Soma dos salários base ativos" />
                                </StackPanel>
                            </Border>
                            <Border Classes="kpi" Margin="7,0,0,0">
                                <StackPanel>
                                    <Border Classes="kpi-icone"><ic:FluentIcon Classes="kpi-icone-symbol" Icon="Calendar" IconVariant="Regular" IconSize="Size20" /></Border>
                                    <TextBlock Classes="kpi-rotulo" Text="Admissões este ano" />
                                    <TextBlock Classes="kpi-valor" Text="{Binding AdmissoesEsteAnoTexto}" />
                                    <TextBlock Classes="kpi-sub" Text="Desde 1 de janeiro" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="2">
                            <Border Classes="campo-busca">
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Text="⌕" FontSize="15" Margin="12,0,2,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextoSecundarioBrush}" />
                                    <TextBox Grid.Column="1" Text="{Binding PesquisaFuncionarios}"
                                             Watermark="Pesquisar por nome, cargo, BI ou código..." />
                                </Grid>
                            </Border>
                            <Button Grid.Column="1" Classes="primario" Command="{Binding NovoFuncionarioCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="+" FontWeight="Bold" />
                                    <TextBlock Text="Novo Funcionário" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Border Classes="cartao" Padding="0">
                            <StackPanel>
                                <Border Classes="cabecalho-tabela">
                                    <Grid ColumnDefinitions="48,0.7*,1.6*,1.2*,1.3*,1.0*,1.0*,0.9*,Auto" Margin="16,12">
                                        <TextBlock Grid.Column="1" Text="CÓDIGO" />
                                        <TextBlock Grid.Column="2" Text="FUNCIONÁRIO / BI" />
                                        <TextBlock Grid.Column="3" Text="CONTACTO" />
                                        <TextBlock Grid.Column="4" Text="CARGO / DEPARTAMENTO" />
                                        <TextBlock Grid.Column="5" Text="TURNO" />
                                        <TextBlock Grid.Column="6" Text="SALÁRIO BASE" />
                                        <TextBlock Grid.Column="7" Text="ESTADO" />
                                        <TextBlock Grid.Column="8" Text="AÇÕES" />
                                    </Grid>
                                </Border>
                                <ItemsControl ItemsSource="{Binding Funcionarios}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="cad:FuncionarioDto">
                                            <Border Classes="linha-tabela" BorderBrush="{DynamicResource BordaBrush}"
                                                    BorderThickness="0,0,0,1" Padding="16,12">
                                                <Grid ColumnDefinitions="48,0.7*,1.6*,1.2*,1.3*,1.0*,1.0*,0.9*,Auto">
                                                    <Border Classes="avatar avatar-info">
                                                        <TextBlock Text="{Binding Nome, Converter={StaticResource IniciaisConverter}}" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding Codigo}"
                                                               Foreground="{DynamicResource VerdePrimarioBrush}"
                                                               FontWeight="Bold" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding BI}" Classes="subtitulo" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Telefone}" FontSize="13" />
                                                        <TextBlock Text="{Binding Email}" Classes="subtitulo" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Cargo}" FontSize="13" />
                                                        <TextBlock Text="{Binding Departamento}" Classes="subtitulo" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="5" Text="{Binding Turno}"
                                                               Foreground="{DynamicResource TextoSecundarioBrush}"
                                                               VerticalAlignment="Center" TextWrapping="Wrap" />
                                                    <TextBlock Grid.Column="6"
                                                               Text="{Binding SalarioBase, Converter={StaticResource ValorKzConverter}}"
                                                               FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <Border Grid.Column="7" VerticalAlignment="Center"
                                                            HorizontalAlignment="Left"
                                                            Classes="badge"
                                                            Classes.badge-sucesso="{Binding Ativo}"
                                                            Classes.badge-neutro="{Binding !Ativo}">
                                                        <Panel>
                                                            <TextBlock Text="Ativo" IsVisible="{Binding Ativo}" />
                                                            <TextBlock Text="Inativo" IsVisible="{Binding !Ativo}" />
                                                        </Panel>
                                                    </Border>
                                                    <StackPanel Grid.Column="8" Orientation="Horizontal" Spacing="6">
                                                        <Button Classes="acao-icone" Content="✎"
                                                                Command="{Binding $parent[UserControl].DataContext.EditarFuncionarioCommand}"
                                                                CommandParameter="{Binding}" />
                                                        <Button Classes="acao-icone perigo" Content="×"
                                                                Command="{Binding $parent[UserControl].DataContext.EliminarFuncionarioCommand}"
                                                                CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>

            </TabControl>

        </StackPanel>
    </ScrollViewer>
            <!-- Popup de cadastro -->
            <Grid IsVisible="{Binding FormularioAberto}" Background="#66000000">
                <Border Classes="cartao" Width="760" MaxHeight="720"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="18">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{Binding EntidadeEmEdicao, StringFormat={}Novo {0}}"
                                               FontSize="20" FontWeight="Bold" />
                                    <TextBlock Classes="subtitulo" Text="Preencha os dados e confirme o cadastro." />
                                </StackPanel>
                                <Button Grid.Column="1" Classes="acao-icone" Content="×"
                                        Command="{Binding FecharFormularioCommand}" />
                            </Grid>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="rotulo-campo" Text="Nome / Razão Social" />
                                    <TextBox Text="{Binding Nome}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Classes="rotulo-campo" Text="Telefone" />
                                    <TextBox Text="{Binding Telefone}" />
                                </StackPanel>
                            </Grid>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="14" IsVisible="{Binding !EhFuncionario}">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="rotulo-campo" Text="Email" />
                                    <TextBox Text="{Binding Email}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Classes="rotulo-campo" Text="NIF" />
                                    <TextBox Text="{Binding Nif}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel IsVisible="{Binding EhFornecedor}" Spacing="4">
                                <TextBlock Classes="rotulo-campo" Text="Produtos fornecidos" />
                                <TextBox Text="{Binding ProdutosFornecidos}" Watermark="ex.: Arroz, óleo, açúcar..." />
                            </StackPanel>

                            <StackPanel IsVisible="{Binding EhFuncionario}" Spacing="14">
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                    <Border Classes="badge" Padding="10" HorizontalAlignment="Stretch">
                                        <TextBlock Text="1 · Dados pessoais" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource VerdePrimarioBrush}" />
                                    </Border>
                                    <Border Grid.Column="1" Classes="badge" Padding="10" HorizontalAlignment="Stretch">
                                        <TextBlock Text="2 · Função" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextoSecundarioBrush}" />
                                    </Border>
                                    <Border Grid.Column="2" Classes="badge" Padding="10" HorizontalAlignment="Stretch">
                                        <TextBlock Text="3 · Contrato" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextoSecundarioBrush}" />
                                    </Border>
                                </Grid>

                                <StackPanel IsVisible="{Binding FuncionarioEtapa1}" Spacing="14">
                                    <TextBlock Text="Dados pessoais" FontSize="16" FontWeight="SemiBold" />
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                                        <StackPanel Spacing="4">
                                            <TextBlock Classes="rotulo-campo" Text="BI" />
                                            <TextBox Text="{Binding Bi}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Classes="rotulo-campo" Text="Email" />
                                            <TextBox Text="{Binding Email}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <StackPanel IsVisible="{Binding FuncionarioEtapa2}" Spacing="14">
                                    <TextBlock Text="Função e organização" FontSize="16" FontWeight="SemiBold" />
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                                        <StackPanel Spacing="4">
                                            <TextBlock Classes="rotulo-campo" Text="Cargo / Perfil" />
                                            <TextBox Text="{Binding Cargo}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Classes="rotulo-campo" Text="Departamento" />
                                            <TextBox Text="{Binding Departamento}" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="rotulo-campo" Text="Turno / Caixa" />
                                        <TextBox Text="{Binding Turno}" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel IsVisible="{Binding FuncionarioEtapa3}" Spacing="14">
                                    <TextBlock Text="Contrato e remuneração" FontSize="16" FontWeight="SemiBold" />
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                                        <StackPanel Spacing="4">
                                            <TextBlock Classes="rotulo-campo" Text="Data de admissão" />
                                            <DatePicker SelectedDate="{Binding DataAdmissao}" HorizontalAlignment="Stretch" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Classes="rotulo-campo" Text="Salário base (Kz)" />
                                            <TextBox Text="{Binding SalarioBase}" />
                                        </StackPanel>
                                    </Grid>
                                    <CheckBox Content="Funcionário ativo" IsChecked="{Binding Ativo}" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Classes="erro" Text="{Binding MensagemErro}"
                                       IsVisible="{Binding MensagemErro, Converter={x:Static ObjectConverters.IsNotNull}}" />

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                                <Button Content="Cancelar" Classes="secundario" Command="{Binding FecharFormularioCommand}" />
                                <Button Content="Voltar" Classes="secundario"
                                        Command="{Binding VoltarEtapaFuncionarioCommand}"
                                        IsVisible="{Binding EhFuncionario}" />
                                <Button Content="Avançar" Classes="primario"
                                        Command="{Binding AvancarEtapaFuncionarioCommand}"
                                        IsVisible="{Binding FuncionarioEtapa1}" />
                                <Button Content="Avançar" Classes="primario"
                                        Command="{Binding AvancarEtapaFuncionarioCommand}"
                                        IsVisible="{Binding FuncionarioEtapa2}" />
                                <Button Content="Guardar" Classes="primario"
                                        Command="{Binding GuardarCommand}"
                                        IsVisible="{Binding FuncionarioEtapa3}"
                                        IsEnabled="{Binding !AGuardar}" />
                                <Button Content="Guardar" Classes="primario"
                                        Command="{Binding GuardarCommand}"
                                        IsVisible="{Binding !EhFuncionario}"
                                        IsEnabled="{Binding !AGuardar}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
</Grid>
</UserControl>