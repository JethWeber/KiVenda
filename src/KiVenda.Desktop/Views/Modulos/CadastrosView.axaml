<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:KiVenda.Desktop.ViewModels.Modulos" xmlns:cad="using:KiVenda.Application.Cadastros" x:Class="KiVenda.Desktop.Views.Modulos.CadastrosView" x:DataType="vm:CadastrosViewModel">
<ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Spacing="18">
<Grid ColumnDefinitions="*"><StackPanel><TextBlock Classes="titulo-pagina" Text="Central de Cadastros"/><TextBlock Classes="subtitulo" Text="Clientes, fornecedores e funcionários num único espaço."/></StackPanel></Grid>
<TabControl SelectedIndex="{Binding AbaSelecionada}">
<TabItem Header="Clientes"><StackPanel Spacing="14"><Grid ColumnDefinitions="*,Auto"><TextBox Text="{Binding PesquisaClientes}" Watermark="Pesquisar por nome, telefone ou NIF..." MaxWidth="520"/><Button Grid.Column="1" Content="+ Novo Cliente" Classes="primario" Command="{Binding NovoClienteCommand}"/></Grid>
<Border Classes="cartao" Padding="0"><StackPanel><Grid ColumnDefinitions="2*,1.2*,1.4*,1.2*,Auto" Margin="16,14,16,10"><TextBlock Text="CLIENTE / RAZÃO SOCIAL" Classes="subtitulo"/><TextBlock Grid.Column="1" Text="CONTACTO" Classes="subtitulo"/><TextBlock Grid.Column="2" Text="EMAIL" Classes="subtitulo"/><TextBlock Grid.Column="3" Text="NIF" Classes="subtitulo"/><TextBlock Grid.Column="4" Text="AÇÕES" Classes="subtitulo"/></Grid>
<ItemsControl ItemsSource="{Binding Clientes}"><ItemsControl.ItemTemplate><DataTemplate DataType="cad:ClienteCadastroDto"><Border BorderBrush="{StaticResource BordaBrush}" BorderThickness="0,1,0,0" Padding="16,13"><Grid ColumnDefinitions="2*,1.2*,1.4*,1.2*,Auto"><StackPanel><TextBlock Text="{Binding Nome}" FontWeight="SemiBold"/><TextBlock Text="Cliente" Classes="subtitulo"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Telefone}" Foreground="{StaticResource TextoSecundarioBrush}"/><TextBlock Grid.Column="2" Text="{Binding Email}" Foreground="{StaticResource TextoSecundarioBrush}"/><TextBlock Grid.Column="3" Text="{Binding Nif}" Foreground="{StaticResource TextoSecundarioBrush}"/><StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4"><Button Content="✎" Command="{Binding $parent[UserControl].DataContext.EditarClienteCommand}" CommandParameter="{Binding}"/><Button Content="×" Command="{Binding $parent[UserControl].DataContext.EliminarClienteCommand}" CommandParameter="{Binding}"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></StackPanel></TabItem>
<TabItem Header="Fornecedores"><StackPanel Spacing="14"><Grid ColumnDefinitions="*,Auto"><TextBox Text="{Binding PesquisaFornecedores}" Watermark="Pesquisar por fornecedor, NIF ou contacto..." MaxWidth="520"/><Button Grid.Column="1" Content="+ Novo Fornecedor" Classes="primario" Command="{Binding NovoFornecedorCommand}"/></Grid><Border Classes="cartao" Padding="0"><StackPanel><Grid ColumnDefinitions="1.6*,1.1*,1.3*,1.1*,1.8*,Auto" Margin="16,14,16,10"><TextBlock Text="FORNECEDOR / RAZÃO SOCIAL" Classes="subtitulo"/><TextBlock Grid.Column="1" Text="CONTACTO" Classes="subtitulo"/><TextBlock Grid.Column="2" Text="EMAIL" Classes="subtitulo"/><TextBlock Grid.Column="3" Text="NIF" Classes="subtitulo"/><TextBlock Grid.Column="4" Text="PRODUTOS FORNECIDOS" Classes="subtitulo"/><TextBlock Grid.Column="5" Text="AÇÕES" Classes="subtitulo"/></Grid><ItemsControl ItemsSource="{Binding Fornecedores}"><ItemsControl.ItemTemplate><DataTemplate DataType="cad:FornecedorCadastroDto"><Border BorderBrush="{StaticResource BordaBrush}" BorderThickness="0,1,0,0" Padding="16,13"><Grid ColumnDefinitions="1.6*,1.1*,1.3*,1.1*,1.8*,Auto"><TextBlock Text="{Binding Nome}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding Telefone}" Foreground="{StaticResource TextoSecundarioBrush}"/><TextBlock Grid.Column="2" Text="{Binding Email}" Foreground="{StaticResource TextoSecundarioBrush}"/><TextBlock Grid.Column="3" Text="{Binding Nif}" Foreground="{StaticResource TextoSecundarioBrush}"/><TextBlock Grid.Column="4" Text="{Binding ProdutosFornecidos}" TextWrapping="Wrap" Foreground="{StaticResource TextoSecundarioBrush}"/><StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4"><Button Content="✎" Command="{Binding $parent[UserControl].DataContext.EditarFornecedorCommand}" CommandParameter="{Binding}"/><Button Content="×" Command="{Binding $parent[UserControl].DataContext.EliminarFornecedorCommand}" CommandParameter="{Binding}"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></StackPanel></TabItem>
<TabItem Header="Funcionários"><StackPanel Spacing="14"><Grid ColumnDefinitions="*,Auto"><TextBox Text="{Binding PesquisaFuncionarios}" Watermark="Pesquisar por nome, cargo, BI ou código..." MaxWidth="520"/><Button Grid.Column="1" Content="+ Novo Funcionário" Classes="primario" Command="{Binding NovoFuncionarioCommand}"/></Grid><Border Classes="cartao" Padding="0"><StackPanel><Grid ColumnDefinitions="0.7*,1.8*,1.2*,1.4*,1.2*,1.1*,1.1*,Auto" Margin="16,14,16,10"><TextBlock Text="CÓDIGO" Classes="subtitulo"/><TextBlock Grid.Column="1" Text="FUNCIONÁRIO / FOTO" Classes="subtitulo"/><TextBlock Grid.Column="2" Text="CONTACTO &amp; BI" Classes="subtitulo"/><TextBlock Grid.Column="3" Text="CARGO / PERFIL" Classes="subtitulo"/><TextBlock Grid.Column="4" Text="TURNO / CAIXA" Classes="subtitulo"/><TextBlock Grid.Column="5" Text="SALÁRIO BASE" Classes="subtitulo"/><TextBlock Grid.Column="6" Text="ESTADO" Classes="subtitulo"/><TextBlock Grid.Column="7" Text="AÇÕES" Classes="subtitulo"/></Grid><ItemsControl ItemsSource="{Binding Funcionarios}"><ItemsControl.ItemTemplate><DataTemplate DataType="cad:FuncionarioDto"><Border BorderBrush="{StaticResource BordaBrush}" BorderThickness="0,1,0,0" Padding="16,13"><Grid ColumnDefinitions="0.7*,1.8*,1.2*,1.4*,1.2*,1.1*,1.1*,Auto"><TextBlock Text="{Binding Codigo}" Foreground="{StaticResource VerdePrimarioBrush}" FontWeight="Bold"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Nome}" FontWeight="SemiBold"/><TextBlock Text="{Binding BI}" Classes="subtitulo"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{Binding Telefone}"/><TextBlock Text="{Binding Email}" Classes="subtitulo"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="{Binding Cargo}"/><TextBlock Text="{Binding Departamento}" Classes="subtitulo"/></StackPanel><TextBlock Grid.Column="4" Text="{Binding Turno}" Foreground="{StaticResource TextoSecundarioBrush}"/><TextBlock Grid.Column="5" Text="{Binding SalarioBase, StringFormat={}{0:N2} Kz}" FontWeight="SemiBold"/><TextBlock Grid.Column="6" Text="{Binding Ativo, StringFormat={}{0}}" Foreground="{StaticResource VerdePrimarioBrush}"/><StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="4"><Button Content="✎" Command="{Binding $parent[UserControl].DataContext.EditarFuncionarioCommand}" CommandParameter="{Binding}"/><Button Content="×" Command="{Binding $parent[UserControl].DataContext.EliminarFuncionarioCommand}" CommandParameter="{Binding}"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></StackPanel></TabItem>
</TabControl>
<Border Classes="cartao" IsVisible="{Binding FormularioAberto}"><StackPanel Spacing="14"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding EntidadeEmEdicao, StringFormat={}Cadastro de {0}}" FontSize="18" FontWeight="Bold"/><Button Grid.Column="1" Content="×" Command="{Binding FecharFormularioCommand}"/></Grid>
<Grid ColumnDefinitions="*,*" ColumnSpacing="14"><StackPanel Spacing="4"><TextBlock Classes="rotulo-campo" Text="Nome / Razão Social"/><TextBox Text="{Binding Nome}"/></StackPanel><StackPanel Grid.Column="1" Spacing="4"><TextBlock Classes="rotulo-campo" Text="Telefone"/><TextBox Text="{Binding Telefone}"/></StackPanel></Grid>
<Grid ColumnDefinitions="*,*" ColumnSpacing="14"><StackPanel Spacing="4"><TextBlock Classes="rotulo-campo" Text="Email"/><TextBox Text="{Binding Email}"/></StackPanel><StackPanel Grid.Column="1" Spacing="4"><TextBlock Classes="rotulo-campo" Text="NIF"/><TextBox Text="{Binding Nif}"/></StackPanel></Grid>
<StackPanel IsVisible="{Binding EhFornecedor}" Spacing="4"><TextBlock Classes="rotulo-campo" Text="Produtos fornecidos"/><TextBox Text="{Binding ProdutosFornecidos}"/></StackPanel>
<StackPanel IsVisible="{Binding EhFuncionario}" Spacing="12"><Grid ColumnDefinitions="*,*"><StackPanel Spacing="4"><TextBlock Classes="rotulo-campo" Text="BI"/><TextBox Text="{Binding Bi}"/></StackPanel><StackPanel Grid.Column="1" Spacing="4"><TextBlock Classes="rotulo-campo" Text="Cargo / Perfil"/><TextBox Text="{Binding Cargo}"/></StackPanel></Grid><Grid ColumnDefinitions="*,*"><StackPanel Spacing="4"><TextBlock Classes="rotulo-campo" Text="Departamento"/><TextBox Text="{Binding Departamento}"/></StackPanel><StackPanel Grid.Column="1" Spacing="4"><TextBlock Classes="rotulo-campo" Text="Turno / Caixa"/><TextBox Text="{Binding Turno}"/></StackPanel></Grid><Grid ColumnDefinitions="*,*"><StackPanel Spacing="4"><TextBlock Classes="rotulo-campo" Text="Data de admissão"/><DatePicker SelectedDate="{Binding DataAdmissao}"/></StackPanel><StackPanel Grid.Column="1" Spacing="4"><TextBlock Classes="rotulo-campo" Text="Salário base (Kz)"/><TextBox Text="{Binding SalarioBase}"/></StackPanel></Grid><CheckBox Content="Funcionário ativo" IsChecked="{Binding Ativo}"/></StackPanel>
<TextBlock Classes="erro" Text="{Binding MensagemErro}" IsVisible="{Binding MensagemErro, Converter={x:Static ObjectConverters.IsNotNull}}"/><StackPanel Orientation="Horizontal" Spacing="10"><Button Content="Guardar" Classes="primario" Command="{Binding GuardarCommand}" IsEnabled="{Binding !AGuardar}"/><Button Content="Cancelar" Classes="secundario" Command="{Binding FecharFormularioCommand}"/></StackPanel></StackPanel></Border>
</StackPanel></ScrollViewer></UserControl>