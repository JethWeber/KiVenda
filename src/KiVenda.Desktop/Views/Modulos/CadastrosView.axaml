<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KiVenda.Desktop.ViewModels.Modulos"
             xmlns:cad="using:KiVenda.Application.Cadastros"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:views="using:KiVenda.Desktop.Views.Modulos"
             x:Class="KiVenda.Desktop.Views.Modulos.CadastrosView"
             x:DataType="vm:CadastrosViewModel">

    <UserControl.Resources>
        <StreamGeometry x:Key="IconeVisto">M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z</StreamGeometry>
        <StreamGeometry x:Key="IconeFechar">M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z</StreamGeometry>
    </UserControl.Resources>

    <UserControl.Styles>

        <!-- ===== Cartões de indicadores (KPIs) ===== -->
        <Style Selector="Border.kpi">
            <Setter Property="Background" Value="{DynamicResource SuperficieBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BordaBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="BoxShadow" Value="0 1 3 0 #0F000000" />
        </Style>
        <Style Selector="Border.kpi-icone">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{DynamicResource VerdeSuaveBrush}" />
        </Style>
        <Style Selector="ic|FluentIcon.kpi-icone-symbol">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Foreground" Value="{DynamicResource VerdePrimarioBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.kpi-rotulo">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextoSecundarioBrush}" />
            <Setter Property="Margin" Value="0,12,0,2" />
        </Style>
        <Style Selector="TextBlock.kpi-valor">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextoPrimarioBrush}" />
        </Style>
        <Style Selector="TextBlock.kpi-sub">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextoSecundarioBrush}" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <!-- ===== Avatares com iniciais (sem fotografias) ===== -->
        <Style Selector="Border.avatar">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Background" Value="{DynamicResource VerdeSuaveBrush}" />
        </Style>
        <Style Selector="Border.avatar TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource VerdePrimarioBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.avatar-info">
            <Setter Property="Background" Value="{DynamicResource InfoSuaveBrush}" />
        </Style>
        <Style Selector="Border.avatar-info TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource InfoBrush}" />
        </Style>

        <!-- ===== Tabela ===== -->
        <Style Selector="Border.cabecalho-tabela">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.cabecalho-tabela TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextoSecundarioBrush}" />
        </Style>
        <Style Selector="Border.linha-tabela:pointerover">
            <Setter Property="Background" Value="{DynamicResource NeutroSuaveBrush}" />
        </Style>
        <Style Selector="Button.acao-icone">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource NeutroSuaveBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextoSecundarioBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.acao-icone.perigo">
            <Setter Property="Background" Value="{DynamicResource PerigoSuaveBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PerigoBrush}" />
        </Style>

        <!-- ===== Separadores (mesmo desenho do Stock) ===== -->
        <Style Selector="Button.tab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="20,11" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource TextoSecundarioBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.tab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NeutroSuaveBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextoPrimarioBrush}" />
        </Style>
        <Style Selector="Button.tab.ativa">
            <Setter Property="Foreground" Value="{DynamicResource VerdePrimarioBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.tab.ativa /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource VerdePrimarioBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource VerdePrimarioBrush}" />
        </Style>
        <Style Selector="Button.tab.ativa:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource VerdePrimarioBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource VerdePrimarioBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid>
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="0">

            <!-- Cabeçalho -->
            <StackPanel Grid.Row="0" Spacing="3" Margin="0,0,0,20">
                <TextBlock Classes="titulo-pagina" Text="Cadastros" />
                <TextBlock Classes="subtitulo" Text="Clientes, fornecedores e funcionários num único espaço." />
            </StackPanel>

            <!-- Separadores -->
            <Border Grid.Row="1"
                    BorderBrush="{DynamicResource BordaBrush}"
                    BorderThickness="0,0,0,1"
                    Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <Button Classes="tab"
                            Classes.ativa="{Binding EhAbaClientes}"
                            Content="Clientes"
                            Command="{Binding SelecionarAbaClientesCommand}" />
                    <Button Classes="tab"
                            Classes.ativa="{Binding EhAbaFornecedores}"
                            Content="Fornecedores"
                            Command="{Binding SelecionarAbaFornecedoresCommand}" />
                    <Button Classes="tab"
                            Classes.ativa="{Binding EhAbaFuncionarios}"
                            Content="Funcionários"
                            Command="{Binding SelecionarAbaFuncionariosCommand}" />
                </StackPanel>
            </Border>

            <!-- Conteúdo -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="20">

                    <TextBlock Classes="erro" Text="{Binding MensagemErro}"
                               IsVisible="{Binding MensagemErro, Converter={x:Static ObjectConverters.IsNotNull}}" />

                    <StackPanel Spacing="20" IsVisible="{Binding EhAbaClientes}">

                        <!-- Barra de ferramentas: pesquisa + ação principal (abre modal) -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Border Background="{DynamicResource SuperficieBrush}"
                                    BorderBrush="{DynamicResource BordaBrush}" BorderThickness="1"
                                    CornerRadius="10" Padding="13,4">
                                <TextBox Text="{Binding PesquisaClientes}" Watermark="Pesquisar por nome, telefone ou NIF..."
                                         Background="Transparent" BorderThickness="0" />
                            </Border>
                            <Button Grid.Column="1" Content="+ Novo Cliente" Classes="primario"
                                    Padding="20,10" VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                                    Command="{Binding NovoClienteCommand}" />
                        </Grid>

                        <Border Classes="cartao" Padding="0">
                            <StackPanel>
                                <Border Classes="cabecalho-tabela">
                                    <Grid ColumnDefinitions="48,2*,1.2*,1.4*,1.2*,Auto" Margin="20,17">
                                        <TextBlock Grid.Column="1" Text="CLIENTE" />
                                        <TextBlock Grid.Column="2" Text="CONTACTO" />
                                        <TextBlock Grid.Column="3" Text="EMAIL" />
                                        <TextBlock Grid.Column="4" Text="NIF" />
                                        <TextBlock Grid.Column="5" Text="AÇÕES" />
                                    </Grid>
                                </Border>
                                <ItemsControl ItemsSource="{Binding Clientes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="cad:ClienteCadastroDto">
                                            <Border Classes="linha-tabela" BorderBrush="{DynamicResource BordaBrush}"
                                                    BorderThickness="0,1,0,0" Padding="20,14">
                                                <Grid ColumnDefinitions="48,2*,1.2*,1.4*,1.2*,Auto">
                                                    <Border Classes="avatar">
                                                        <TextBlock Text="{Binding Nome, Converter={StaticResource IniciaisConverter}}" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding Nome}"
                                                               FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Telefone}"
                                                               Foreground="{DynamicResource TextoSecundarioBrush}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="3" Text="{Binding Email}"
                                                               Foreground="{DynamicResource TextoSecundarioBrush}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="4" Text="{Binding Nif}"
                                                               Foreground="{DynamicResource TextoSecundarioBrush}"
                                                               VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6">
                                                        <Button Classes="acao-icone" Content="✎"
                                                                Command="{Binding $parent[UserControl].DataContext.EditarClienteCommand}"
                                                                CommandParameter="{Binding}" />
                                                        <Button Classes="acao-icone perigo" Content="×"
                                                                Command="{Binding $parent[UserControl].DataContext.EliminarClienteCommand}"
                                                                CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="20" IsVisible="{Binding EhAbaFornecedores}">

                        <!-- Barra de ferramentas: pesquisa + ação principal (abre modal) -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Border Background="{DynamicResource SuperficieBrush}"
                                    BorderBrush="{DynamicResource BordaBrush}" BorderThickness="1"
                                    CornerRadius="10" Padding="13,4">
                                <TextBox Text="{Binding PesquisaFornecedores}" Watermark="Pesquisar por fornecedor, NIF ou contacto..."
                                         Background="Transparent" BorderThickness="0" />
                            </Border>
                            <Button Grid.Column="1" Content="+ Novo Fornecedor" Classes="primario"
                                    Padding="20,10" VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                                    Command="{Binding NovoFornecedorCommand}" />
                        </Grid>

                        <Border Classes="cartao" Padding="0">
                            <StackPanel>
                                <Border Classes="cabecalho-tabela">
                                    <Grid ColumnDefinitions="48,1.6*,1.1*,1.3*,1.1*,1.6*,Auto" Margin="20,17">
                                        <TextBlock Grid.Column="1" Text="FORNECEDOR" />
                                        <TextBlock Grid.Column="2" Text="CONTACTO" />
                                        <TextBlock Grid.Column="3" Text="EMAIL" />
                                        <TextBlock Grid.Column="4" Text="NIF" />
                                        <TextBlock Grid.Column="5" Text="PRODUTOS FORNECIDOS" />
                                        <TextBlock Grid.Column="6" Text="AÇÕES" />
                                    </Grid>
                                </Border>
                                <ItemsControl ItemsSource="{Binding Fornecedores}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="cad:FornecedorCadastroDto">
                                            <Border Classes="linha-tabela" BorderBrush="{DynamicResource BordaBrush}"
                                                    BorderThickness="0,1,0,0" Padding="20,14">
                                                <Grid ColumnDefinitions="48,1.6*,1.1*,1.3*,1.1*,1.6*,Auto">
                                                    <Border Classes="avatar avatar-info">
                                                        <TextBlock Text="{Binding Nome, Converter={StaticResource IniciaisConverter}}" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding Nome}"
                                                               FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Telefone}"
                                                               Foreground="{DynamicResource TextoSecundarioBrush}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="3" Text="{Binding Email}"
                                                               Foreground="{DynamicResource TextoSecundarioBrush}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="4" Text="{Binding Nif}"
                                                               Foreground="{DynamicResource TextoSecundarioBrush}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="5" Text="{Binding ProdutosFornecidos}"
                                                               TextWrapping="Wrap"
                                                               Foreground="{DynamicResource TextoSecundarioBrush}"
                                                               VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="6">
                                                        <Button Classes="acao-icone" Content="✎"
                                                                Command="{Binding $parent[UserControl].DataContext.EditarFornecedorCommand}"
                                                                CommandParameter="{Binding}" />
                                                        <Button Classes="acao-icone perigo" Content="×"
                                                                Command="{Binding $parent[UserControl].DataContext.EliminarFornecedorCommand}"
                                                                CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="20" IsVisible="{Binding EhAbaFuncionarios}">

                        <UniformGrid Columns="4" Rows="1">
                            <Border Classes="kpi" Margin="0,0,7,0">
                                <StackPanel>
                                    <Border Classes="kpi-icone"><ic:FluentIcon Classes="kpi-icone-symbol" Icon="People" IconVariant="Regular" IconSize="Size20" /></Border>
                                    <TextBlock Classes="kpi-rotulo" Text="Total de Funcionários" />
                                    <TextBlock Classes="kpi-valor" Text="{Binding TotalFuncionariosTexto}" />
                                    <TextBlock Classes="kpi-sub" Text="Registados no sistema" />
                                </StackPanel>
                            </Border>
                            <Border Classes="kpi" Margin="7,0">
                                <StackPanel>
                                    <Border Classes="kpi-icone"><ic:FluentIcon Classes="kpi-icone-symbol" Icon="PersonAvailable" IconVariant="Regular" IconSize="Size20" /></Border>
                                    <TextBlock Classes="kpi-rotulo" Text="Funcionários Ativos" />
                                    <TextBlock Classes="kpi-valor" Text="{Binding FuncionariosAtivosTexto}" />
                                    <TextBlock Classes="kpi-sub">
                                        <Run Text="{Binding FuncionariosInativosTexto}" />
                                        <Run Text=" inativo(s)" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Classes="kpi" Margin="7,0">
                                <StackPanel>
                                    <Border Classes="kpi-icone"><ic:FluentIcon Classes="kpi-icone-symbol" Icon="Money" IconVariant="Regular" IconSize="Size20" /></Border>
                                    <TextBlock Classes="kpi-rotulo" Text="Massa Salarial" />
                                    <TextBlock Classes="kpi-valor" Text="{Binding MassaSalarialTexto}" />
                                    <TextBlock Classes="kpi-sub" Text="Soma dos salários base ativos" />
                                </StackPanel>
                            </Border>
                            <Border Classes="kpi" Margin="7,0,0,0">
                                <StackPanel>
                                    <Border Classes="kpi-icone"><ic:FluentIcon Classes="kpi-icone-symbol" Icon="Calendar" IconVariant="Regular" IconSize="Size20" /></Border>
                                    <TextBlock Classes="kpi-rotulo" Text="Admissões este ano" />
                                    <TextBlock Classes="kpi-valor" Text="{Binding AdmissoesEsteAnoTexto}" />
                                    <TextBlock Classes="kpi-sub" Text="Desde 1 de janeiro" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Barra de ferramentas: pesquisa + ação principal (abre modal) -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Border Background="{DynamicResource SuperficieBrush}"
                                    BorderBrush="{DynamicResource BordaBrush}" BorderThickness="1"
                                    CornerRadius="10" Padding="13,4">
                                <TextBox Text="{Binding PesquisaFuncionarios}" Watermark="Pesquisar por nome, cargo, BI ou código..."
                                         Background="Transparent" BorderThickness="0" />
                            </Border>
                            <Button Grid.Column="1" Content="+ Novo Funcionário" Classes="primario"
                                    Padding="20,10" VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                                    Command="{Binding NovoFuncionarioCommand}" />
                        </Grid>

                        <Border Classes="cartao" Padding="0">
                            <StackPanel>
                                <Border Classes="cabecalho-tabela">
                                    <Grid ColumnDefinitions="48,0.7*,1.6*,1.2*,1.3*,1.0*,1.0*,0.9*,Auto" Margin="20,17">
                                        <TextBlock Grid.Column="1" Text="CÓDIGO" />
                                        <TextBlock Grid.Column="2" Text="FUNCIONÁRIO / BI" />
                                        <TextBlock Grid.Column="3" Text="CONTACTO" />
                                        <TextBlock Grid.Column="4" Text="CARGO / DEPARTAMENTO" />
                                        <TextBlock Grid.Column="5" Text="TURNO" />
                                        <TextBlock Grid.Column="6" Text="SALÁRIO BASE" />
                                        <TextBlock Grid.Column="7" Text="ESTADO" />
                                        <TextBlock Grid.Column="8" Text="AÇÕES" />
                                    </Grid>
                                </Border>
                                <ItemsControl ItemsSource="{Binding Funcionarios}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="cad:FuncionarioDto">
                                            <Border Classes="linha-tabela" BorderBrush="{DynamicResource BordaBrush}"
                                                    BorderThickness="0,1,0,0" Padding="20,14">
                                                <Grid ColumnDefinitions="48,0.7*,1.6*,1.2*,1.3*,1.0*,1.0*,0.9*,Auto">
                                                    <Border Classes="avatar avatar-info">
                                                        <TextBlock Text="{Binding Nome, Converter={StaticResource IniciaisConverter}}" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding Codigo}"
                                                               Foreground="{DynamicResource VerdePrimarioBrush}"
                                                               FontWeight="Bold" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding BI}" Classes="subtitulo" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Telefone}" FontSize="13" />
                                                        <TextBlock Text="{Binding Email}" Classes="subtitulo" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Cargo}" FontSize="13" />
                                                        <TextBlock Text="{Binding Departamento}" Classes="subtitulo" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="5" Text="{Binding Turno}"
                                                               Foreground="{DynamicResource TextoSecundarioBrush}"
                                                               VerticalAlignment="Center" TextWrapping="Wrap" />
                                                    <TextBlock Grid.Column="6"
                                                               Text="{Binding SalarioBase, Converter={StaticResource ValorKzConverter}}"
                                                               FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <Border Grid.Column="7" VerticalAlignment="Center"
                                                            HorizontalAlignment="Left"
                                                            Classes="badge"
                                                            Classes.badge-sucesso="{Binding Ativo}"
                                                            Classes.badge-neutro="{Binding !Ativo}">
                                                        <Panel>
                                                            <TextBlock Text="Ativo" IsVisible="{Binding Ativo}" />
                                                            <TextBlock Text="Inativo" IsVisible="{Binding !Ativo}" />
                                                        </Panel>
                                                    </Border>
                                                    <StackPanel Grid.Column="8" Orientation="Horizontal" Spacing="6">
                                                        <Button Classes="acao-icone" Content="✎"
                                                                Command="{Binding $parent[UserControl].DataContext.EditarFuncionarioCommand}"
                                                                CommandParameter="{Binding}" />
                                                        <Button Classes="acao-icone perigo" Content="×"
                                                                Command="{Binding $parent[UserControl].DataContext.EliminarFuncionarioCommand}"
                                                                CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Modal de cadastro (UserControl): por cima da página inteira -->
        <views:CadastroModal />

        <!-- Aviso de sucesso/erro: sem botão, some sozinho em 3 s -->
        <Border IsVisible="{Binding ToastVisivel}"
                IsHitTestVisible="False"
                ZIndex="100"
                Background="#44000000">

            <Grid Width="320"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">

                <Border Classes="cartao"
                        Margin="0,32,0,0"
                        Padding="24,44,24,24"
                        CornerRadius="12"
                        BoxShadow="0 12 32 0 #66000000">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding ToastTitulo}"
                                   FontSize="22"
                                   FontWeight="Light"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding ToastMensagem}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Opacity="0.85" />
                    </StackPanel>
                </Border>

                <!-- Círculo de sucesso (verde + visto) -->
                <Border Width="64" Height="64" CornerRadius="32"
                        VerticalAlignment="Top" HorizontalAlignment="Center"
                        Background="{StaticResource SucessoBrush}"
                        IsVisible="{Binding !ToastErro}">
                    <PathIcon Data="{StaticResource IconeVisto}" Width="32" Height="32" Foreground="White" />
                </Border>

                <!-- Círculo de erro (vermelho + X) -->
                <Border Width="64" Height="64" CornerRadius="32"
                        VerticalAlignment="Top" HorizontalAlignment="Center"
                        Background="{StaticResource PerigoBrush}"
                        IsVisible="{Binding ToastErro}">
                    <PathIcon Data="{StaticResource IconeFechar}" Width="28" Height="28" Foreground="White" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
