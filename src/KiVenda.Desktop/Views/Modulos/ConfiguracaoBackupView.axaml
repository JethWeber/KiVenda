<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KiVenda.Desktop.ViewModels.Modulos"
             x:Class="KiVenda.Desktop.Views.Modulos.ConfiguracaoBackupView"
             x:DataType="vm:ConfiguracaoBackupViewModel">

    <Grid ColumnDefinitions="1.5*,*" ColumnSpacing="24" VerticalAlignment="Top">

        <!-- ═══ Ações ═══ -->
        <Border Grid.Column="0" Classes="cartao cfg-card" VerticalAlignment="Top">
            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
                    <PathIcon Classes="cfg-accent" Data="{DynamicResource CfgIconBackup}" />
                    <TextBlock Classes="cfg-card-title" Text="Cópias de segurança" />
                </StackPanel>
                <TextBlock Classes="cfg-body" Margin="0,0,0,12"
                           Text="Proteja os dados do KiVenda com cópias locais da base de dados." />

                <!-- Criar -->
                <Border Classes="cfg-row">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                        <Border Classes="cfg-icon-chip" VerticalAlignment="Top">
                            <PathIcon Foreground="{DynamicResource VerdePrimarioBrush}"
                                      Data="{DynamicResource CfgIconBackup}" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Classes="cfg-value" Text="Criar backup" />
                            <TextBlock Classes="cfg-body"
                                       Text="Cria uma cópia consistente da base de dados SQLite. Escolha a pasta onde o ficheiro será guardado." />
                        </StackPanel>
                        <Button Grid.Column="2" Classes="primario cfg"
                                VerticalAlignment="Center"
                                IsEnabled="{Binding PodeExecutar}"
                                Click="CriarBackup_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{DynamicResource CfgIconSave}" Width="16" Height="16" />
                                <TextBlock Text="Criar backup" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Restaurar -->
                <Border Classes="cfg-row" BorderThickness="0" Padding="0,14,0,0">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                        <Border Classes="cfg-icon-chip" VerticalAlignment="Top">
                            <PathIcon Foreground="{DynamicResource TextoSecundarioBrush}"
                                      Data="{DynamicResource CfgIconRestore}" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Classes="cfg-value" Text="Restaurar backup" />
                            <TextBlock Classes="cfg-body"
                                       Text="Selecione um backup válido para substituir a base de dados atual. Reinicie o KiVenda depois da restauração." />
                        </StackPanel>
                        <Button Grid.Column="2" Classes="secundario cfg"
                                VerticalAlignment="Center"
                                IsEnabled="{Binding PodeExecutar}"
                                Click="RestaurarBackup_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{DynamicResource CfgIconUpload}" Width="16" Height="16" />
                                <TextBlock Text="Selecionar e restaurar" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- ═══ Estado ═══ -->
        <StackPanel Grid.Column="1" Spacing="24" VerticalAlignment="Top">
            <Border Classes="cartao cfg-card">
                <StackPanel Spacing="18">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <PathIcon Classes="cfg-accent" Data="{DynamicResource CfgIconShield}" />
                        <TextBlock Classes="cfg-card-title" Text="Estado" />
                    </StackPanel>

                    <Border Classes="cfg-inset">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <PathIcon Data="{DynamicResource CfgIconCheck}"
                                      Width="20" Height="20"
                                      VerticalAlignment="Top"
                                      Foreground="{DynamicResource VerdePrimarioBrush}" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Classes="cfg-label" Text="Último backup" />
                                <TextBlock Classes="cfg-value" Text="{Binding UltimoBackup}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Spacing="4">
                        <TextBlock Classes="cfg-label" Text="Mensagem" />
                        <TextBlock Classes="cfg-body" Text="{Binding Mensagem}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Aviso -->
            <Border CornerRadius="14"
                    Padding="18"
                    Background="{DynamicResource NeutroSuaveBrush}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <PathIcon Data="{DynamicResource CfgIconWarning}"
                              Width="20" Height="20"
                              VerticalAlignment="Top"
                              Foreground="{DynamicResource TextoSecundarioBrush}" />
                    <TextBlock Grid.Column="1"
                               FontSize="13"
                               LineHeight="19"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextoSecundarioBrush}"
                               Text="Mantenha os backups noutro disco ou dispositivo. Um backup guardado apenas no mesmo computador não protege contra falha do armazenamento." />
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
