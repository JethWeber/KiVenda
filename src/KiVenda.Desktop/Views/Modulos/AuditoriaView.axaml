<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KiVenda.Desktop.ViewModels.Modulos"
             xmlns:aud="using:KiVenda.Core.Auditoria"
             x:Class="KiVenda.Desktop.Views.Modulos.AuditoriaView"
             x:DataType="vm:AuditoriaViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="20">

            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="3">
                    <TextBlock Classes="titulo-pagina" Text="Auditoria" />
                    <TextBlock Classes="subtitulo" Text="Quem fez o quê, quando e em que registo." />
                </StackPanel>
                <Border Grid.Column="1" Classes="badge badge-neutro">
                    <TextBlock Text="REGISTO DE OPERAÇÕES" FontSize="10" FontWeight="Bold" />
                </Border>
            </Grid>

            <Border Classes="cartao">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
                        <StackPanel Spacing="5">
                            <TextBlock Classes="rotulo-campo" Text="De" />
                            <DatePicker SelectedDate="{Binding DataDe}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="5">
                            <TextBlock Classes="rotulo-campo" Text="Até" />
                            <DatePicker SelectedDate="{Binding DataAte}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="5">
                            <TextBlock Classes="rotulo-campo" Text="Utilizador" />
                            <ComboBox ItemsSource="{Binding Utilizadores}"
                                      SelectedItem="{Binding UtilizadorSelecionado}"
                                      PlaceholderText="Todos" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Spacing="5">
                            <TextBlock Classes="rotulo-campo" Text="Entidade" />
                            <ComboBox ItemsSource="{Binding Entidades}"
                                      SelectedItem="{Binding EntidadeSelecionada}" />
                        </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                        <TextBox Grid.Column="0" Text="{Binding Acao}"
                                 Watermark="Pesquisar ação ou operação..." />
                        <Button Grid.Column="1" Content="Aplicar filtros" Classes="primario"
                                Command="{Binding CarregarCommand}" IsEnabled="{Binding !ACarregar}" />
                        <Button Grid.Column="2" Content="Limpar" Classes="secundario"
                                Command="{Binding LimparFiltrosCommand}" IsEnabled="{Binding !ACarregar}" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Text="{Binding Mensagem}" Classes="subtitulo" />
                        <TextBlock Grid.Column="1" Text="A carregar..." Classes="subtitulo"
                                   HorizontalAlignment="Right" IsVisible="{Binding ACarregar}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Classes="cartao" Padding="0">
                <StackPanel>
                    <Grid ColumnDefinitions="170,170,140,*" Margin="20,17">
                        <TextBlock Text="DATA / HORA" Classes="subtitulo" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="AÇÃO" Classes="subtitulo" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="ENTIDADE" Classes="subtitulo" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="DETALHES" Classes="subtitulo" FontWeight="SemiBold" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Registos}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="aud:LogAuditoria">
                                <Border BorderBrush="{StaticResource BordaBrush}"
                                        BorderThickness="0,1,0,0"
                                        Padding="20,14">
                                    <Grid ColumnDefinitions="170,170,140,*" ColumnSpacing="10">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding DataHora, StringFormat={}{0:dd/MM/yyyy}}" FontWeight="Medium" />
                                            <TextBlock Text="{Binding DataHora, StringFormat={}{0:HH:mm:ss}}" Classes="subtitulo" FontSize="11" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Classes="badge badge-neutro" HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Acao}" FontSize="10" />
                                        </Border>
                                        <StackPanel Grid.Column="2" Spacing="3">
                                            <TextBlock Text="{Binding EntidadeAfetada}" FontWeight="Medium" />
                                            <TextBlock Text="{Binding EntidadeId, StringFormat='ID: {0}'}" Classes="subtitulo" FontSize="10" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Spacing="4">
                                            <TextBlock Text="{Binding DadosDepois, StringFormat='Depois: {0}'}"
                                                       TextWrapping="Wrap"
                                                       IsVisible="{Binding DadosDepois, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                            <TextBlock Text="{Binding DadosAntes, StringFormat='Antes: {0}'}"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource TextoSecundarioBrush}"
                                                       IsVisible="{Binding DadosAntes, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>