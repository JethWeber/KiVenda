<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KiVenda.Desktop.ViewModels.Modulos"
             xmlns:impressao="using:KiVenda.Infrastructure.Impressao"
             x:Class="KiVenda.Desktop.Views.Modulos.ConfiguracaoImpressoraView"
             x:DataType="vm:ConfiguracaoImpressoraViewModel">
    <StackPanel Spacing="18" MaxWidth="760">
        <StackPanel Spacing="4">
            <TextBlock Classes="titulo-pagina" Text="Impressora térmica" />
            <TextBlock Classes="subtitulo"
                       Text="O KiVenda usa ESC/POS diretamente. O sistema operativo define as opções locais disponíveis; a ligação de rede pode ser usada em Windows ou Linux."
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border Classes="cartao" Padding="18">
            <StackPanel Spacing="16">
                <TextBlock Text="Ligação da impressora" FontSize="18" FontWeight="Bold" />

                <CheckBox Content="Ativar impressão térmica"
                          IsChecked="{Binding Ativo}"
                          IsEnabled="{Binding !ACarregar}" />

                <StackPanel Spacing="6">
                    <TextBlock Text="Tipo de ligação" FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding TiposConexao}"
                              SelectedItem="{Binding TipoConexaoSelecionada, Mode=TwoWay}"
                              IsEnabled="{Binding !ACarregar}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="impressao:OpcaoConexaoImpressora">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Descricao}"
                                               Classes="subtitulo"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Spacing="6" IsVisible="{Binding EhConexaoLocal}">
                    <TextBlock Text="Dispositivo" FontWeight="SemiBold" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding Dispositivos}"
                                  SelectedItem="{Binding DispositivoSelecionado, Mode=TwoWay}"
                                  IsVisible="{Binding !MostrarEntradaManual}"
                                  IsEnabled="{Binding !ACarregar}"
                                  MaxWidth="600">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="impressao:DispositivoImpressora">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Porta}"
                                                   Classes="subtitulo"
                                                   TextWrapping="NoWrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBox Grid.Column="0"
                                 Text="{Binding Dispositivo}"
                                 Watermark="COM3 ou /dev/usb/lp0"
                                 IsVisible="{Binding MostrarEntradaManual}"
                                 IsEnabled="{Binding !ACarregar}" />

                        <Button Grid.Column="1"
                                Content="🔄 Procurar"
                                Command="{Binding ProcurarCommand}"
                                IsVisible="{Binding !MostrarEntradaManual}"
                                IsEnabled="{Binding !ADetetar}" />
                    </Grid>

                    <TextBlock Text="{Binding EstadoDeteccao}"
                               Classes="subtitulo"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="{Binding EhRede}">
                    <StackPanel Grid.Column="0" Spacing="6">
                        <TextBlock Text="IP ou hostname" FontWeight="SemiBold" />
                        <TextBox Text="{Binding EnderecoRede}"
                                 Watermark="192.168.1.200"
                                 IsEnabled="{Binding !ACarregar}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="6" Width="120">
                        <TextBlock Text="Porta TCP" FontWeight="SemiBold" />
                        <NumericUpDown Value="{Binding PortaRede}"
                                       Minimum="1"
                                       Maximum="65535"
                                       FormatString="0"
                                       IsEnabled="{Binding !ACarregar}" />
                    </StackPanel>
                </Grid>

                <StackPanel Spacing="6" IsVisible="{Binding EhSerial}">
                    <TextBlock Text="Velocidade serial (baud)" FontWeight="SemiBold" />
                    <NumericUpDown Value="{Binding BaudRate}"
                                   Minimum="1200"
                                   Maximum="921600"
                                   Increment="1200"
                                   FormatString="0"
                                   IsEnabled="{Binding !ACarregar}" />
                    <TextBlock Classes="subtitulo"
                               Text="Se a impressora usar USB-Serial, o sistema deve expô-la como uma porta COM no Windows ou ttyUSB/ttyACM no Linux."
                               TextWrapping="Wrap" />
                </StackPanel>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                    <StackPanel Grid.Column="0" Spacing="6">
                        <TextBlock Text="Largura" FontWeight="SemiBold" />
                        <NumericUpDown Value="{Binding Colunas}"
                                       Minimum="24"
                                       Maximum="64"
                                       FormatString="0"
                                       IsEnabled="{Binding !ACarregar}" />
                        <TextBlock Classes="subtitulo" Text="Normalmente 32, 40 ou 48 colunas." />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Text="Alimentação final" FontWeight="SemiBold" />
                        <NumericUpDown Value="{Binding LinhasAlimentacaoFinal}"
                                       Minimum="0"
                                       Maximum="20"
                                       FormatString="0"
                                       IsEnabled="{Binding !ACarregar}" />
                    </StackPanel>
                </Grid>

                <StackPanel Spacing="6">
                    <TextBlock Text="Codificação" FontWeight="SemiBold" />
                    <TextBox Text="{Binding EncodingNome}"
                             Watermark="cp850"
                             IsEnabled="{Binding !ACarregar}" />
                    <TextBlock Classes="subtitulo"
                               Text="Padrão cp850. Se caracteres como ã, ç ou outros saírem incorretos, deve ser escolhida uma code page compatível com a impressora."
                               TextWrapping="Wrap" />
                </StackPanel>

                <CheckBox Content="Cortar papel automaticamente"
                          IsChecked="{Binding CortarPapel}"
                          IsEnabled="{Binding !ACarregar}" />

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="🖨 Testar impressão"
                            Classes="secundario"
                            Command="{Binding TestarCommand}"
                            IsEnabled="{Binding !ATestar}" />
                    <Button Content="Guardar configuração"
                            Classes="primario"
                            Command="{Binding GuardarCommand}"
                            IsEnabled="{Binding !AGuardar}" />
                    <Button Content="Restaurar padrão"
                            Classes="secundario"
                            Command="{Binding RestaurarPadraoCommand}"
                            IsEnabled="{Binding !AGuardar}" />
                </StackPanel>

                <TextBlock Text="{Binding Mensagem}"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextoSecundarioBrush}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
