<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmm="using:KiVenda.Desktop.ViewModels.Modulos"
             xmlns:produtos="using:KiVenda.Application.Produtos"
             x:Class="KiVenda.Desktop.Views.Modulos.ProdutosView"
             x:DataType="vmm:ProdutosViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="20">

            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="3">
                    <TextBlock Classes="titulo-pagina" Text="Produtos" />
                    <TextBlock Classes="subtitulo" Text="Catálogo, preços e estado do stock." />
                </StackPanel>
                <Button Grid.Column="1" Content="+ Novo Produto" Classes="primario"
                        Command="{Binding AbrirFormularioCommand}" IsVisible="{Binding PodeCriar}" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                <Border Background="{StaticResource SuperficieBrush}"
                        BorderBrush="{StaticResource BordaBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="13,4">
                    <TextBox Text="{Binding TermoPesquisa}" Watermark="Pesquisar por nome, código ou EAN..."
                             Background="Transparent" BorderThickness="0" />
                </Border>
                <Border Grid.Column="1" Classes="badge badge-neutro" VerticalAlignment="Center">
                    <TextBlock Text="INVENTÁRIO" FontSize="10" FontWeight="Bold" />
                </Border>
            </Grid>

            <TextBlock Classes="erro" Text="{Binding MensagemErro}"
                       IsVisible="{Binding MensagemErro, Converter={x:Static ObjectConverters.IsNotNull}}" />

            <Border Classes="cartao" IsVisible="{Binding FormularioAberto}">
                <StackPanel Spacing="15">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Novo Produto" FontSize="18" FontWeight="Bold" />
                            <TextBlock Classes="subtitulo" Text="Cadastre o produto que será vendido no KiVenda." />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Cancelar" Classes="secundario"
                                Command="{Binding FecharFormularioCommand}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16" RowDefinitions="Auto,Auto,Auto">
                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="5">
                            <TextBlock Classes="rotulo-campo" Text="Nome" />
                            <TextBox Text="{Binding NovoNome}" Watermark="ex.: Arroz Tio Lucas" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="5">
                            <TextBlock Classes="rotulo-campo" Text="Código de barras" />
                            <TextBox Text="{Binding NovoCodigoBarras}" Watermark="Opcional" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="5">
                            <TextBlock Classes="rotulo-campo" Text="Categoria" />
                            <ComboBox ItemsSource="{Binding Categorias}" SelectedItem="{Binding CategoriaSelecionada}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="produtos:CategoriaDto">
                                        <TextBlock Text="{Binding Nome}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="5">
                            <TextBlock Classes="rotulo-campo" Text="Unidade base" />
                            <ComboBox ItemsSource="{Binding Unidades}" SelectedItem="{Binding UnidadeSelecionada}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="produtos:UnidadeMedidaDto">
                                        <TextBlock Text="{Binding Nome}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="0" Spacing="5">
                            <TextBlock Classes="rotulo-campo" Text="Preço de venda" />
                            <TextBox Text="{Binding NovoPrecoVenda}" Watermark="Kz por unidade base" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="5">
                            <TextBlock Classes="rotulo-campo" Text="Stock mínimo" />
                            <TextBox Text="{Binding NovoStockMinimo}" Watermark="Quantidade mínima" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Classes="erro" Text="{Binding MensagemErroFormulario}"
                               IsVisible="{Binding MensagemErroFormulario, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Guardar produto" Classes="primario"
                                Command="{Binding GuardarCommand}" IsEnabled="{Binding !AGuardar}" />
                        <Button Content="Cancelar" Classes="secundario"
                                Command="{Binding FecharFormularioCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Classes="cartao" Padding="0">
                <StackPanel>
                    <Grid ColumnDefinitions="2*,1.3*,1.1*,1*,1.1*" Margin="20,17">
                        <TextBlock Text="PRODUTO" Classes="subtitulo" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="CÓDIGO" Classes="subtitulo" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="PREÇO" Classes="subtitulo" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="STOCK" Classes="subtitulo" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="4" Text="ESTADO" Classes="subtitulo" FontWeight="SemiBold" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Itens}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="produtos:ProdutoDto">
                                <Border BorderBrush="{StaticResource BordaBrush}" BorderThickness="0,1,0,0" Padding="20,14">
                                    <Grid ColumnDefinitions="2*,1.3*,1.1*,1*,1.1*">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding CodigoBarras}" Classes="subtitulo" FontSize="10"
                                                       IsVisible="{Binding CodigoBarras, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding CodigoInterno}"
                                                   Foreground="{StaticResource TextoSecundarioBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding PrecoVendaPorUnidadeBase, Converter={StaticResource ValorKzConverter}, ConverterParameter=2}"
                                                   Foreground="{StaticResource SucessoBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding EstoqueAtual, StringFormat={}{0:N2}}"
                                                   VerticalAlignment="Center" />
                                        <Border Grid.Column="4" HorizontalAlignment="Left" Classes="badge"
                                                Background="{Binding EstadoStock, Converter={StaticResource EstadoStockParaCorFundoConverter}}">
                                            <TextBlock Text="{Binding EstadoStock, Converter={StaticResource EstadoStockParaTextoConverter}}"
                                                       Foreground="{Binding EstadoStock, Converter={StaticResource EstadoStockParaCorTextoConverter}}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>