<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KiVenda.Desktop.ViewModels.Modulos"
             x:Class="KiVenda.Desktop.Views.Modulos.ConfiguracaoLicencaView"
             x:DataType="vm:ConfiguracaoLicencaViewModel">
<ScrollViewer VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Disabled">
    <Grid ColumnDefinitions="1.4*,*" ColumnSpacing="24" VerticalAlignment="Top">

        <!-- ═══ Licença atual ═══ -->
        <Border Grid.Column="0" Classes="cartao cfg-card" VerticalAlignment="Top">
            <StackPanel Spacing="22">

                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <PathIcon Classes="cfg-accent" Data="{DynamicResource CfgIconKey}" />
                        <TextBlock Classes="cfg-card-title" Text="Licença atual" />
                    </StackPanel>

                    <Border Grid.Column="1" Classes="cfg-chip green" IsVisible="{Binding LicencaValida}">
                        <TextBlock Text="Válida" />
                    </Border>
                    <Border Grid.Column="1" Classes="cfg-chip amber" IsVisible="{Binding !LicencaValida}">
                        <TextBlock Text="{Binding Estado}" />
                    </Border>
                </Grid>

                <TextBlock Classes="cfg-body" Text="{Binding Mensagem}" />

                <!-- Detalhes (só com licença carregada) -->
                <StackPanel Spacing="22" IsVisible="{Binding MostrarDetalhes}">
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="24" RowSpacing="22">
                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                            <TextBlock Classes="cfg-label" Text="Cliente" />
                            <TextBlock Classes="cfg-value" Text="{Binding Cliente}" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                            <TextBlock Classes="cfg-label" Text="Plano" />
                            <TextBlock Classes="cfg-value" Text="{Binding Plano}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                            <TextBlock Classes="cfg-label" Text="Validade" />
                            <TextBlock Classes="cfg-value" Text="{Binding Validade}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                            <TextBlock Classes="cfg-label" Text="Dias restantes" />
                            <TextBlock Classes="cfg-value" Text="{Binding DiasRestantes}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="8">
                        <TextBlock Classes="cfg-label" Text="Módulos contratados" />
                        <Border Classes="cfg-chip green">
                            <TextBlock Text="Todos os módulos incluídos" />
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!--
                Machine ID (como no mock): adicione `public string MachineId` ao
                ConfiguracaoLicencaViewModel e retire este comentário.

                <Border Classes="cfg-inset">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <PathIcon Data="{DynamicResource CfgIconLaptop}" Width="20" Height="20"
                                  Foreground="{DynamicResource TextoSecundarioBrush}" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Classes="cfg-label" Text="Machine ID desta instalação" />
                            <TextBlock Classes="cfg-value" Text="{Binding MachineId}" />
                        </StackPanel>
                    </Grid>
                </Border>
                -->
            </StackPanel>
        </Border>

        <!-- ═══ Ativação offline ═══ -->
        <Border Grid.Column="1" Classes="cartao cfg-card" VerticalAlignment="Top">
            <StackPanel Spacing="20">

                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                    <PathIcon Classes="cfg-accent" Data="{DynamicResource CfgIconQr}" />
                    <TextBlock Classes="cfg-card-title" Text="Ativação offline" />
                </StackPanel>

                <!-- QR: placeholder quando ainda não há código -->
                <Grid HorizontalAlignment="Center">
                    <Border Classes="cfg-inset" Width="190" Height="190" IsVisible="{Binding !MostrarQr}">
                        <PathIcon Data="{DynamicResource CfgIconQr}"
                                  Width="64" Height="64"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Foreground="{DynamicResource TextoSecundarioBrush}" />
                    </Border>
                    <Border Width="230" Height="230"
                            CornerRadius="14"
                            Background="White"
                            Padding="12"
                            IsVisible="{Binding MostrarQr}">
                        <Image Source="{Binding QrCode}" Stretch="Uniform" />
                    </Border>
                </Grid>

                <TextBlock Classes="cfg-body"
                           TextAlignment="Center"
                           Text="Mostre este QR Code à Weber Tech para emitir a licença desta máquina. Depois importe o ficheiro .wta recebido." />

                <!--
                Botão "Gerar QR Code de Ativação" (como no mock): crie um
                GerarQrCommand no ViewModel e retire este comentário.

                <Button Classes="primario cfg" HorizontalAlignment="Stretch" Height="48"
                        Command="{Binding GerarQrCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <PathIcon Data="{DynamicResource CfgIconQr}" Width="18" Height="18" />
                        <TextBlock Text="Gerar QR Code de ativação" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                -->

                <Button Classes="primario cfg"
                        Height="48"
                        HorizontalAlignment="Stretch"
                        IsEnabled="{Binding PodeImportar}"
                        Click="ImportarLicenca_Click">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <PathIcon Data="{DynamicResource CfgIconUpload}" Width="18" Height="18" />
                        <TextBlock Text="Importar ficheiro de licença (.wta)" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <TextBlock Classes="cfg-hint"
                           TextAlignment="Center"
                           Text="Depois da primeira ativação, use o ficheiro de renovação quando a assinatura expirar." />
            </StackPanel>
        </Border>
    </Grid>
</ScrollViewer>
</UserControl>
