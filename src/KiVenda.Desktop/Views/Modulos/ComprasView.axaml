<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmm="using:KiVenda.Desktop.ViewModels.Modulos"
             xmlns:compras="using:KiVenda.Application.Compras"
             xmlns:fornecedores="using:KiVenda.Application.Fornecedores"
             xmlns:produtos="using:KiVenda.Application.Produtos"
             x:Class="KiVenda.Desktop.Views.Modulos.ComprasView"
             x:DataType="vmm:ComprasViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="20">

            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <StackPanel Spacing="3">
                    <TextBlock Classes="titulo-pagina" Text="Abastecer" />
                    <TextBlock Classes="subtitulo" Text="Registe compras e acompanhe a entrada de stock." />
                </StackPanel>
                <Button Grid.Column="1" Content="+ Nova Compra" Classes="primario"
                        Command="{Binding AbrirFormularioCommand}" />
            </Grid>

            <TextBlock Classes="erro" Text="{Binding MensagemErro}"
                       IsVisible="{Binding MensagemErro, Converter={x:Static ObjectConverters.IsNotNull}}" />

            <Border Classes="cartao" IsVisible="{Binding FormularioAberto}">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Nova Compra" FontSize="18" FontWeight="Bold" />
                            <TextBlock Classes="subtitulo" Text="A entrada será refletida no stock automaticamente." />
                        </StackPanel>
                        <Border Grid.Column="1" Classes="badge badge-neutro">
                            <TextBlock Text="ENTRADA DE STOCK" FontSize="10" FontWeight="Bold" />
                        </Border>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                        <StackPanel Grid.Column="0" Spacing="5">
                            <TextBlock Classes="rotulo-campo" Text="Fornecedor" />
                            <ComboBox ItemsSource="{Binding Fornecedores}"
                                      SelectedItem="{Binding FornecedorSelecionado}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="fornecedores:FornecedorDto">
                                        <TextBlock Text="{Binding Nome}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="5">
                            <TextBlock Classes="rotulo-campo" Text="Produto" />
                            <ComboBox ItemsSource="{Binding Produtos}"
                                      SelectedItem="{Binding ProdutoSelecionado}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="produtos:ProdutoDto">
                                        <TextBlock Text="{Binding Nome}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                        <StackPanel Grid.Column="0" Spacing="5">
                            <TextBlock Classes="rotulo-campo" Text="Quantidade" />
                            <TextBox Text="{Binding Quantidade}" Watermark="ex.: 25" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="5">
                            <TextBlock Classes="rotulo-campo" Text="Custo total (Kz)" />
                            <TextBox Text="{Binding CustoTotal}" Watermark="ex.: 27500" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Classes="erro" Text="{Binding MensagemErroFormulario}"
                               IsVisible="{Binding MensagemErroFormulario, Converter={x:Static ObjectConverters.IsNotNull}}" />

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Registar compra" Classes="primario"
                                Command="{Binding GuardarCommand}" IsEnabled="{Binding !AGuardar}" />
                        <Button Content="Cancelar" Classes="secundario"
                                Command="{Binding FecharFormularioCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Classes="cartao" Padding="0">
                <StackPanel>
                    <Grid ColumnDefinitions="2*,1.2*,1.2*,1*" Margin="20,18,20,12">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Histórico de Compras" FontWeight="Bold" FontSize="16" />
                            <TextBlock Classes="subtitulo" Text="Produtos recebidos e custo das entradas." FontSize="12" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="FORNECEDOR" Classes="subtitulo" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="PRODUTO" Classes="subtitulo" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="CUSTO" Classes="subtitulo" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Itens}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="compras:CompraDto">
                                <Border BorderBrush="{StaticResource BordaBrush}"
                                        BorderThickness="0,1,0,0"
                                        Padding="20,15">
                                    <Grid ColumnDefinitions="2*,1.2*,1.2*,1*">
                                        <StackPanel Grid.Column="0" Spacing="3">
                                            <TextBlock Text="{Binding Data, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"
                                                       FontWeight="Medium" />
                                            <TextBlock Text="{Binding UtilizadorId, StringFormat='Operador: {0}'}"
                                                       Classes="subtitulo" FontSize="10" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding FornecedorNome, StringFormat='{}{0}'}"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap" />

                                        <ItemsControl Grid.Column="2" ItemsSource="{Binding Itens}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="compras:ItemCompraDto">
                                                    <StackPanel Spacing="2" Margin="0,0,0,5">
                                                        <TextBlock Text="{Binding ProdutoNome, FallbackValue='Produto'}"
                                                                   FontWeight="SemiBold"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding ApresentacaoNome}"
                                                                   Classes="subtitulo" FontSize="10"
                                                                   IsVisible="{Binding ApresentacaoNome, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                        <TextBlock Text="{Binding QuantidadeNaApresentacao, StringFormat='Qtd.: {0:N2}'}"
                                                                   Classes="subtitulo" FontSize="10" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding CustoTotal, Converter={StaticResource ValorKzConverter}, ConverterParameter=2}"
                                                   Foreground="{StaticResource SucessoBrush}"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>