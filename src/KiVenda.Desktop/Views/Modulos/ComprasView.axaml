<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmm="using:KiVenda.Desktop.ViewModels.Modulos"
             xmlns:compras="using:KiVenda.Application.Compras"
             xmlns:fornecedores="using:KiVenda.Application.Fornecedores"
             xmlns:produtos="using:KiVenda.Application.Produtos"
             x:Class="KiVenda.Desktop.Views.Modulos.ComprasView"
             x:DataType="vmm:ComprasViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="20">

            <!-- Barra de ações (o formulário abre num modal) -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Classes="subtitulo" Text="Registe compras e acompanhe a entrada de stock."
                           VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="+ Nova Compra" Classes="primario"
                        Padding="20,10"
                        Command="{Binding AbrirFormularioCommand}" />
            </Grid>

            <TextBlock Classes="erro" Text="{Binding MensagemErro}"
                       IsVisible="{Binding MensagemErro, Converter={x:Static ObjectConverters.IsNotNull}}" />

            <Border Classes="cartao" Padding="0">
                <StackPanel>
                    <Grid ColumnDefinitions="2*,1.2*,1.2*,1*" Margin="20,18,20,12">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Histórico de Compras" FontWeight="Bold" FontSize="16" />
                            <TextBlock Classes="subtitulo" Text="Produtos recebidos e custo das entradas." FontSize="12" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="FORNECEDOR" Classes="subtitulo" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="PRODUTO" Classes="subtitulo" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="CUSTO" Classes="subtitulo" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Itens}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="compras:CompraDto">
                                <Border BorderBrush="{StaticResource BordaBrush}"
                                        BorderThickness="0,1,0,0"
                                        Padding="20,15">
                                    <Grid ColumnDefinitions="2*,1.2*,1.2*,1*">
                                        <StackPanel Grid.Column="0" Spacing="3">
                                            <TextBlock Text="{Binding Data, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"
                                                       FontWeight="Medium" />
                                            <TextBlock Text="{Binding UtilizadorId, StringFormat='Operador: {0}'}"
                                                       Classes="subtitulo" FontSize="10" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding FornecedorNome, StringFormat='{}{0}'}"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap" />

                                        <ItemsControl Grid.Column="2" ItemsSource="{Binding Itens}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="compras:ItemCompraDto">
                                                    <StackPanel Spacing="2" Margin="0,0,0,5">
                                                        <TextBlock Text="{Binding ProdutoNome, FallbackValue='Produto'}"
                                                                   FontWeight="SemiBold"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding ApresentacaoNome}"
                                                                   Classes="subtitulo" FontSize="10"
                                                                   IsVisible="{Binding ApresentacaoNome, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                        <TextBlock Text="{Binding QuantidadeNaApresentacao, StringFormat='Qtd.: {0:N2}'}"
                                                                   Classes="subtitulo" FontSize="10" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding CustoTotal, Converter={StaticResource ValorKzConverter}, ConverterParameter=2}"
                                                   Foreground="{StaticResource SucessoBrush}"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>