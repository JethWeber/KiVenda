<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmm="using:KiVenda.Desktop.ViewModels.Modulos"
             xmlns:rel="using:KiVenda.Application.Relatorios"
             xmlns:util="using:KiVenda.Application.Utilizadores"
             x:Class="KiVenda.Desktop.Views.Modulos.RelatoriosView"
             x:DataType="vmm:RelatoriosViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="20">

            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <StackPanel Spacing="3">
                    <TextBlock Classes="titulo-pagina" Text="Relatórios" />
                    <TextBlock Classes="subtitulo" Text="Acompanhe vendas, resultados e estado do stock." />
                </StackPanel>
                <Button Grid.Column="1" Content="Imprimir relatório" Classes="primario"
                        Command="{Binding ImprimirCommand}" IsEnabled="{Binding !ACarregar}" />
            </Grid>

            <Border Background="{DynamicResource SuperficieBrush}"
                    BorderBrush="{DynamicResource BordaBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="5">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Content="Diário" Command="{Binding SelecionarDiarioCommand}" Classes="secundario" Padding="18,9" />
                    <Button Content="Mensal" Command="{Binding SelecionarMensalCommand}" Classes="secundario" Padding="18,9" />
                    <Button Content="Stock" Command="{Binding SelecionarStockCommand}" Classes="secundario" Padding="18,9" />
                </StackPanel>
            </Border>

            <Border Classes="cartao">
                <Grid ColumnDefinitions="Auto,220,Auto,220,*" ColumnSpacing="12">
                    <TextBlock Grid.Column="0" Classes="rotulo-campo" Text="Período" VerticalAlignment="Center"
                               IsVisible="{Binding MostrarFiltrosData}" />
                    <DatePicker Grid.Column="1" SelectedDate="{Binding DataSelecionada}"
                                IsVisible="{Binding MostrarFiltrosData}" />
                    <TextBlock Grid.Column="2" Classes="rotulo-campo" Text="Utilizador" VerticalAlignment="Center"
                               IsVisible="{Binding MostrarFiltroUtilizador}" />
                    <ComboBox Grid.Column="3" ItemsSource="{Binding Utilizadores}"
                              SelectedItem="{Binding UtilizadorSelecionado}"
                              PlaceholderText="Todos os utilizadores"
                              IsVisible="{Binding MostrarFiltroUtilizador}" />
                    <TextBlock Grid.Column="4" Text="A carregar..." HorizontalAlignment="Right"
                               Foreground="{DynamicResource TextoSecundarioBrush}"
                               IsVisible="{Binding ACarregar}" />
                </Grid>
            </Border>

            <TextBlock Classes="erro" Text="{Binding Mensagem}"
                       IsVisible="{Binding Mensagem, Converter={x:Static ObjectConverters.IsNotNull}}" />

            <!-- Diário -->
            <StackPanel Spacing="16" IsVisible="{Binding MostrarDiario}">
                <Border Classes="cartao" IsVisible="{Binding Diario, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <StackPanel Spacing="18">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="3">
                                <TextBlock Text="Relatório Diário" FontSize="19" FontWeight="Bold" />
                                <TextBlock Text="{Binding Diario.Data, StringFormat='{}{0:dddd, dd/MM/yyyy}'}"
                                           Classes="subtitulo" />
                            </StackPanel>
                            <Border Grid.Column="1" Classes="badge badge-neutro">
                                <TextBlock Text="VENDAS DO DIA" FontSize="10" FontWeight="Bold" />
                            </Border>
                        </Grid>

                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
                            <Border Grid.Column="0" Classes="cartao-estatistica">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Total vendido" Classes="subtitulo" />
                                    <TextBlock Text="{Binding Diario.TotalVendido, Converter={StaticResource ValorKzConverter}}"
                                               FontSize="21" FontWeight="Bold" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Classes="cartao-estatistica">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Lucro estimado" Classes="subtitulo" />
                                    <TextBlock Text="{Binding Diario.LucroEstimado, Converter={StaticResource ValorKzConverter}}"
                                               FontSize="21" FontWeight="Bold"
                                               Foreground="{StaticResource SucessoBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Classes="cartao-estatistica">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Vendas realizadas" Classes="subtitulo" />
                                    <TextBlock Text="{Binding Diario.NumeroDeVendas}" FontSize="21" FontWeight="Bold" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3" Classes="cartao-estatistica">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Produtos vendidos" Classes="subtitulo" />
                                    <TextBlock Text="{Binding Diario.ProdutosVendidos.Count}" FontSize="21" FontWeight="Bold" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="cartao" Padding="0"
                        IsVisible="{Binding Diario, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <StackPanel>
                        <Grid ColumnDefinitions="2*,1*,1.2*" Margin="20,17">
                            <TextBlock Text="Produtos vendidos" FontWeight="Bold" FontSize="15" />
                            <TextBlock Grid.Column="1" Text="QUANTIDADE" Classes="subtitulo" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="TOTAL" Classes="subtitulo" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Diario.ProdutosVendidos}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="rel:ProdutoVendidoDto">
                                    <Border BorderBrush="{StaticResource BordaBrush}" BorderThickness="0,1,0,0" Padding="20,13">
                                        <Grid ColumnDefinitions="2*,1*,1.2*">
                                            <TextBlock Text="{Binding ProdutoNome}" FontWeight="Medium" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="1" Text="{Binding QuantidadeUnidadeBase, StringFormat={}{0:N2}}" />
                                            <TextBlock Grid.Column="2" Text="{Binding ValorTotalVendido, Converter={StaticResource ValorKzConverter}}"
                                                       HorizontalAlignment="Right" FontWeight="SemiBold" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Mensal -->
            <StackPanel Spacing="16" IsVisible="{Binding MostrarMensal}">
                <Border Classes="cartao" IsVisible="{Binding Mensal, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <StackPanel Spacing="18">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="3">
                                <TextBlock Text="Relatório Mensal" FontSize="19" FontWeight="Bold" />
                                <TextBlock Text="{Binding Mensal.Mes, StringFormat='Mês {0}'}" Classes="subtitulo" />
                            </StackPanel>
                            <Border Grid.Column="1" Classes="badge badge-neutro">
                                <TextBlock Text="{Binding Mensal.Ano, StringFormat='ANO {0}'}" FontSize="10" FontWeight="Bold" />
                            </Border>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Border Grid.Column="0" Classes="cartao-estatistica">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Receita" Classes="subtitulo" />
                                    <TextBlock Text="{Binding Mensal.Receita, Converter={StaticResource ValorKzConverter}}" FontSize="22" FontWeight="Bold" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Classes="cartao-estatistica">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Lucro estimado" Classes="subtitulo" />
                                    <TextBlock Text="{Binding Mensal.LucroEstimado, Converter={StaticResource ValorKzConverter}}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource SucessoBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="cartao" Padding="0" IsVisible="{Binding Mensal, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <StackPanel>
                        <TextBlock Text="Produtos mais vendidos" FontWeight="Bold" FontSize="15" Margin="20,17" />
                        <ItemsControl ItemsSource="{Binding Mensal.ProdutosMaisVendidos}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="rel:ProdutoVendidoDto">
                                    <Border BorderBrush="{StaticResource BordaBrush}" BorderThickness="0,1,0,0" Padding="20,13">
                                        <Grid ColumnDefinitions="2*,1*,1.2*">
                                            <TextBlock Text="{Binding ProdutoNome}" FontWeight="Medium" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="1" Text="{Binding QuantidadeUnidadeBase, StringFormat={}{0:N2}}" />
                                            <TextBlock Grid.Column="2" Text="{Binding ValorTotalVendido, Converter={StaticResource ValorKzConverter}}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Stock -->
            <StackPanel Spacing="16" IsVisible="{Binding MostrarStock}">
                <Border Classes="cartao" IsVisible="{Binding Stock, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="*,* " ColumnSpacing="12">
                            <Border Classes="cartao-estatistica">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Em falta" Classes="subtitulo" />
                                    <TextBlock Text="{Binding Stock.ProdutosEmFalta.Count}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PerigoBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Classes="cartao-estatistica">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Stock baixo" Classes="subtitulo" />
                                    <TextBlock Text="{Binding Stock.ProdutosComStockBaixo.Count}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AvisoBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="cartao" Padding="0" IsVisible="{Binding Stock, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <StackPanel>
                        <TextBlock Text="Produtos em falta" FontWeight="Bold" FontSize="15" Margin="20,17" />
                        <ItemsControl ItemsSource="{Binding Stock.ProdutosEmFalta}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="rel:ProdutoStockDto">
                                    <Border BorderBrush="{StaticResource BordaBrush}" BorderThickness="0,1,0,0" Padding="20,13">
                                        <Grid ColumnDefinitions="2*,1*,1*">
                                            <TextBlock Text="{Binding ProdutoNome}" FontWeight="Medium" />
                                            <TextBlock Grid.Column="1" Text="{Binding QuantidadeApresentacao, StringFormat={}{0:N2}}" />
                                            <TextBlock Grid.Column="2" Text="{Binding UnidadeStock}" HorizontalAlignment="Right" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Stock baixo" FontWeight="Bold" FontSize="15" Margin="20,20,20,12" />
                        <ItemsControl ItemsSource="{Binding Stock.ProdutosComStockBaixo}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="rel:ProdutoStockDto">
                                    <Border BorderBrush="{StaticResource BordaBrush}" BorderThickness="0,1,0,0" Padding="20,13">
                                        <Grid ColumnDefinitions="2*,1*,1*">
                                            <TextBlock Text="{Binding ProdutoNome}" FontWeight="Medium" />
                                            <TextBlock Grid.Column="1" Text="{Binding EstoqueAtual, StringFormat={}{0:N2}}" />
                                            <TextBlock Grid.Column="2" Text="{Binding StockMinimo, StringFormat='mín. {0:N2}'}" HorizontalAlignment="Right" Classes="subtitulo" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>