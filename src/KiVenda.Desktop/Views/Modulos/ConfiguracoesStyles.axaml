            <StreamGeometry x:Key="CfgIconShield">M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z</StreamGeometry>
            <StreamGeometry x:Key="CfgIconInfo">M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z</StreamGeometry>
            <StreamGeometry x:Key="CfgIconWarning">M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z</StreamGeometry>
            <StreamGeometry x:Key="CfgIconPalette">M12 3a9 9 0 0 0 0 18c.83 0 1.5-.67 1.5-1.5 0-.39-.15-.74-.39-1.01-.23-.26-.38-.61-.38-.99 0-.83.67-1.5 1.5-1.5H16c2.76 0 5-2.24 5-5 0-4.42-4.03-8-9-8zm-5.5 9c-.83 0-1.5-.67-1.5-1.5S5.67 9 6.5 9 8 9.67 8 10.5 7.33 12 6.5 12zm3-4C8.67 8 8 7.33 8 6.5S8.67 5 9.5 5s1.5.67 1.5 1.5S10.33 8 9.5 8zm5 0c-.83 0-1.5-.67-1.5-1.5S13.67 5 14.5 5s1.5.67 1.5 1.5S15.33 8 14.5 8zm3 4c-.83 0-1.5-.67-1.5-1.5S16.67 9 17.5 9s1.5.67 1.5 1.5-.67 1.5-1.5 1.5z</StreamGeometry>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- ═════════ Superfícies ═════════ -->
    <Style Selector="Border.cfg-card">
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="24" />
    </Style>

    <Style Selector="Border.cfg-inset">
        <Setter Property="Background" Value="{DynamicResource NeutroSuaveBrush}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style Selector="Border.cfg-row">
        <Setter Property="BorderBrush" Value="{DynamicResource NeutroSuaveBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="0,14" />
    </Style>

    <Style Selector="Border.cfg-icon-chip">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="{DynamicResource VerdeSuaveBrush}" />
    </Style>
    <Style Selector="Border.cfg-icon-chip > PathIcon">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Badges -->
    <Style Selector="Border.cfg-chip">
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Border.cfg-chip > TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.cfg-chip.green">
        <Setter Property="Background" Value="{DynamicResource VerdeSuaveBrush}" />
    </Style>
    <Style Selector="Border.cfg-chip.green > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource VerdePrimarioBrush}" />
    </Style>
    <Style Selector="Border.cfg-chip.amber">
        <Setter Property="Background" Value="{DynamicResource NeutroSuaveBrush}" />
    </Style>
    <Style Selector="Border.cfg-chip.amber > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextoSecundarioBrush}" />
    </Style>

    <!-- ═════════ Tipografia ═════════ -->
    <Style Selector="TextBlock.cfg-page-title">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.cfg-card-title">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.cfg-label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextoSecundarioBrush}" />
    </Style>
    <Style Selector="TextBlock.cfg-value">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.cfg-body">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="19" />
        <Setter Property="Foreground" Value="{DynamicResource TextoSecundarioBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.cfg-hint">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextoSecundarioBrush}" />
        <Setter Property="Opacity" Value="0.85" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="PathIcon.cfg-accent">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Foreground" Value="{DynamicResource VerdePrimarioBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="StackPanel.cfg-field">
        <Setter Property="Spacing" Value="6" />
    </Style>

    <!-- ═════════ Entradas ═════════ -->
    <Style Selector="TextBox.cfg">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ComboBox.cfg">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="NumericUpDown.cfg">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <!-- ═════════ Botões (cores vêm de primario / secundario) ═════════ -->
    <Style Selector="Button.cfg">
        <Setter Property="Height" Value="42" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.cfg.link">
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextoSecundarioBrush}" />
    </Style>
    <Style Selector="Button.cfg.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource VerdePrimarioBrush}" />
    </Style>

    <!-- ═════════ Abas em pílula (como o mock) ═════════ -->
    <Style Selector="TabControl.cfg-tabs">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="4" />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Grid RowDefinitions="Auto,Auto,*">
                    <!-- O botão "Guardar alterações" sobrepõe-se a esta linha (altura 52) -->
                    <Border Grid.Row="0"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource NeutroSuaveBrush}"
                            CornerRadius="26"
                            Padding="6">
                        <ItemsPresenter Name="PART_ItemsPresenter"
                                        ItemsPanel="{TemplateBinding ItemsPanel}" />
                    </Border>
                    <Border Grid.Row="1"
                            Height="1"
                            Margin="0,22,0,0"
                            Background="{DynamicResource NeutroSuaveBrush}" />
                    <ScrollViewer Grid.Row="2"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ContentPresenter Name="PART_SelectedContentHost"
                                          Margin="0,24,14,24"
                                          Content="{TemplateBinding SelectedContent}"
                                          ContentTemplate="{TemplateBinding SelectedContentTemplate}" />
                    </ScrollViewer>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="TabControl.cfg-tabs > TabItem">
        <Setter Property="Height" Value="40" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextoSecundarioBrush}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Pill"
                        Background="{TemplateBinding Background}"
                        CornerRadius="20"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Name="PillContent"
                                      Content="{TemplateBinding Header}"
                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="TabControl.cfg-tabs > TabItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource VerdeSuaveBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource VerdePrimarioBrush}" />
    </Style>
    <Style Selector="TabControl.cfg-tabs > TabItem:selected">
        <Setter Property="Background" Value="{DynamicResource VerdePrimarioBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="TabControl.cfg-tabs > TabItem:selected:pointerover">
        <Setter Property="Background" Value="{DynamicResource VerdePrimarioBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="TabControl.cfg-tabs > TabItem PathIcon">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
    </Style>

</Styles>
