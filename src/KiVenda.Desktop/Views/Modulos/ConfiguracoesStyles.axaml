<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Usa apenas as cores que a app já tem:
         VerdePrimarioBrush, VerdeSuaveBrush, NeutroSuaveBrush, TextoSecundarioBrush
         e as classes cartao / primario / secundario. -->

    <Styles.Resources>
        <ResourceDictionary>
            <StreamGeometry x:Key="CfgIconBusiness">M12 7V3H2v18h20V7H12zM6 19H4v-2h2v2zm0-4H4v-2h2v2zm0-4H4V9h2v2zm0-4H4V5h2v2zm4 12H8v-2h2v2zm0-4H8v-2h2v2zm0-4H8V9h2v2zm0-4H8V5h2v2zm10 12h-8v-2h2v-2h-2v-2h2v-2h-2V9h8v10zm-2-8h-2v2h2v-2zm0 4h-2v2h2v-2z</StreamGeometry>
