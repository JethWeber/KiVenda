<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KiVenda.Desktop.ViewModels.Modulos"
             xmlns:views="using:KiVenda.Desktop.Views.Modulos"
             x:Class="KiVenda.Desktop.Views.Modulos.StockView"
             x:DataType="vm:StockViewModel">

    <Grid RowDefinitions="Auto,*" RowSpacing="20">
        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
            <StackPanel Spacing="3">
                <TextBlock Classes="titulo-pagina" Text="Stock" />
                <TextBlock Classes="subtitulo" Text="Produtos, entradas e controlo do inventário." />
            </StackPanel>
            <Border Grid.Column="1" Classes="badge badge-neutro" Padding="12,7">
                <TextBlock Text="GESTÃO DE INVENTÁRIO" FontSize="10" FontWeight="Bold" />
            </Border>
        </Grid>

        <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="16">
            <Border Background="{DynamicResource SuperficieBrush}"
                    BorderBrush="{DynamicResource BordaBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="5">
                <Grid ColumnDefinitions="Auto,Auto,*">
                    <Grid Grid.Column="0">
                        <Button Classes="primario" Content="Produto"
                                Command="{Binding SelecionarProdutosCommand}"
                                Padding="18,9"
                                IsVisible="{Binding MostrarProdutos}" />
                        <Button Classes="secundario" Content="Produto"
                                Command="{Binding SelecionarProdutosCommand}"
                                Padding="18,9"
                                IsVisible="{Binding MostrarAbastecer}" />
                    </Grid>
                    <Grid Grid.Column="1" Margin="4,0,0,0">
                        <Button Classes="primario" Content="Abastecer"
                                Command="{Binding SelecionarAbastecerCommand}"
                                Padding="18,9"
                                IsVisible="{Binding MostrarAbastecer}" />
                        <Button Classes="secundario" Content="Abastecer"
                                Command="{Binding SelecionarAbastecerCommand}"
                                Padding="18,9"
                                IsVisible="{Binding MostrarProdutos}" />
                    </Grid>
                </Grid>
            </Border>

                        <Grid Grid.Row="1">
                <views:ProdutosView DataContext="{Binding Produtos}" IsVisible="{Binding MostrarProdutos}" />
                <views:ComprasView DataContext="{Binding Abastecer}" IsVisible="{Binding MostrarAbastecer}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>