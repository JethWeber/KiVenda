<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KiVenda.Desktop.ViewModels.Modulos"
             xmlns:views="using:KiVenda.Desktop.Views.Modulos"
             x:Class="KiVenda.Desktop.Views.Modulos.StockView"
             x:Name="Root"
             x:DataType="vm:StockViewModel">

    <UserControl.Resources>
        <StreamGeometry x:Key="IconeVisto">M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z</StreamGeometry>
        <StreamGeometry x:Key="IconeFechar">M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z</StreamGeometry>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Separadores (tabs) com indicador inferior -->
        <Style Selector="Button.tab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="20,11" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource TextoSecundarioBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.tab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NeutroSuaveBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextoPrimarioBrush}" />
        </Style>
        <Style Selector="Button.tab.ativa">
            <Setter Property="Foreground" Value="{DynamicResource VerdePrimarioBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.tab.ativa /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource VerdePrimarioBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource VerdePrimarioBrush}" />
        </Style>
        <Style Selector="Button.tab.ativa:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource VerdePrimarioBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource VerdePrimarioBrush}" />
        </Style>
        <!-- Aviso de sucesso/erro: aparece e some com fade -->
        <Style Selector="Border.toast-fundo">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Border.toast-fundo.mostrar">
            <Setter Property="Opacity" Value="1" />
        </Style>
    </UserControl.Styles>

    <Grid>
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="0">

            <!-- Cabeçalho -->
            <StackPanel Grid.Row="0" Spacing="3" Margin="0,0,0,20">
                <TextBlock Classes="titulo-pagina" Text="Stock" />
                <TextBlock Classes="subtitulo" Text="Produtos, entradas e controlo do inventário." />
            </StackPanel>

            <!-- Separadores -->
            <Border Grid.Row="1"
                    BorderBrush="{DynamicResource BordaBrush}"
                    BorderThickness="0,0,0,1"
                    Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <Button Classes="tab"
                            Classes.ativa="{Binding MostrarProdutos}"
                            Content="Produtos"
                            Command="{Binding SelecionarProdutosCommand}" />
                    <Button Classes="tab"
                            Classes.ativa="{Binding MostrarAbastecer}"
                            Content="Abastecer"
                            Command="{Binding SelecionarAbastecerCommand}" />
                </StackPanel>
            </Border>

            <!-- Conteúdo -->
            <Grid Grid.Row="2">
                <views:ProdutosView DataContext="{Binding Produtos}"
                                    IsVisible="{Binding #Root.DataContext.MostrarProdutos}" />
                <views:ComprasView DataContext="{Binding Abastecer}"
                                   IsVisible="{Binding #Root.DataContext.MostrarAbastecer}" />
            </Grid>
        </Grid>

        <!-- Modais: ficam por cima da página inteira do Stock (inclui os separadores) -->
        <views:NovoProdutoModal DataContext="{Binding Produtos}" />
        <views:NovaCompraModal DataContext="{Binding Abastecer}" />

        <!-- Aviso de sucesso/erro: sem botão, some sozinho em 3 s -->
        <Border Classes="toast-fundo"
                Classes.mostrar="{Binding ToastVisivel}"
                IsHitTestVisible="False"
                Background="#44000000">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
                </Transitions>
            </Border.Transitions>

            <Grid Width="320"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">

                <Border Classes="cartao"
                        Margin="0,32,0,0"
                        Padding="24,44,24,24"
                        CornerRadius="12"
                        BoxShadow="0 12 32 0 #66000000">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding ToastTitulo}"
                                   FontSize="22"
                                   FontWeight="Light"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding ToastMensagem}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Opacity="0.85" />
                    </StackPanel>
                </Border>

                <!-- Círculo de sucesso (verde + visto) -->
                <Border Width="64" Height="64" CornerRadius="32"
                        VerticalAlignment="Top" HorizontalAlignment="Center"
                        Background="{DynamicResource SucessoBrush}"
                        IsVisible="{Binding !ToastErro}">
                    <PathIcon Data="{StaticResource IconeVisto}" Width="32" Height="32" Foreground="White" />
                </Border>

                <!-- Círculo de erro (vermelho + X) -->
                <Border Width="64" Height="64" CornerRadius="32"
                        VerticalAlignment="Top" HorizontalAlignment="Center"
                        Background="{DynamicResource PerigoBrush}"
                        IsVisible="{Binding ToastErro}">
                    <PathIcon Data="{StaticResource IconeFechar}" Width="28" Height="28" Foreground="White" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
