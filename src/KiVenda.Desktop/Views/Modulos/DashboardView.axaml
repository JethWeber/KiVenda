<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             xmlns:vmm="using:KiVenda.Desktop.ViewModels.Modulos"
             x:Class="KiVenda.Desktop.Views.Modulos.DashboardView"
             x:DataType="vmm:DashboardViewModel">

    <UserControl.Styles>
        <Style Selector="Border.kpi">
            <Setter Property="Background" Value="{DynamicResource SuperficieBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BordaBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="BoxShadow" Value="0 4 10 0 #0A000000" />
        </Style>
        <Style Selector="Border.kpi-icon">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="TextBlock.kpi-label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextoSecundarioBrush}" />
        </Style>
        <Style Selector="TextBlock.kpi-value">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextoPrimarioBrush}" />
        </Style>
        <Style Selector="Border.painel">
            <Setter Property="Background" Value="{DynamicResource SuperficieBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BordaBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="BoxShadow" Value="0 4 10 0 #0A000000" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="26">

        <!-- Cabeçalho do dashboard -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
            <StackPanel Spacing="5">
                <TextBlock Classes="titulo-pagina"
                           FontSize="28">
                    <Run Text="{Binding SaudacaoAtual}" />
                    <Run Text=", " />
                    <Run Text="{Binding NomeUtilizador}" />
                </TextBlock>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="▣"
                               FontSize="14"
                               Foreground="{DynamicResource TextoSecundarioBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding DataAtualTexto}"
                               FontSize="13"
                               Foreground="{DynamicResource TextoSecundarioBrush}" />
                </StackPanel>
            </StackPanel>

            <Button Grid.Column="1"
                    Classes="primario"
                    Content="＋  Nova Venda (F2)"
                    FontSize="13"
                    Padding="18,12"
                    Margin="20,0,0,0" />
        </Grid>

        <TextBlock Grid.Row="1"
                   Classes="erro"
                   Text="{Binding MensagemErro}"
                   IsVisible="{Binding MensagemErro, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <!-- KPIs -->
        <UniformGrid Grid.Row="2"
                     Columns="5"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Top">

            <Border Classes="kpi" Margin="0,0,8,0">
                <StackPanel>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,18">
                        <Border Classes="kpi-icon" Background="{DynamicResource VerdeSuaveBrush}">
                            <TextBlock Text="↗" FontSize="24" FontWeight="Bold"
                                       Foreground="{DynamicResource VerdePrimarioBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border Grid.Column="1" Background="{DynamicResource VerdeSuaveClaroBrush}"
                                CornerRadius="999" Padding="8,4" VerticalAlignment="Top">
                            <TextBlock Text="Hoje" FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource VerdePrimarioBrush}" />
                        </Border>
                    </Grid>
                    <TextBlock Classes="kpi-label" Text="Vendas de Hoje" />
                    <TextBlock Classes="kpi-value" Text="{Binding VendasDeHojeTexto}" Margin="0,3,0,0" />
                </StackPanel>
            </Border>

            <Border Classes="kpi" Margin="8,0">
                <StackPanel>
                    <Border Classes="kpi-icon" Background="{DynamicResource InfoSuaveBrush}" Margin="0,0,0,18">
                        <TextBlock Text="▣" FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource InfoBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Classes="kpi-label" Text="Caixa Atual" />
                    <TextBlock Classes="kpi-value" Text="{Binding CaixaAtualTexto}" Margin="0,3,0,0" />
                </StackPanel>
            </Border>

            <Border Classes="kpi" Margin="8,0">
                <StackPanel>
                    <Border Classes="kpi-icon" Background="{DynamicResource InfoSuaveBrush}" Margin="0,0,0,18">
                        <TextBlock Text="◉" FontSize="21" FontWeight="Bold"
                                   Foreground="{DynamicResource InfoBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Classes="kpi-label" Text="Lucro Estimado" />
                    <TextBlock Classes="kpi-value" Text="{Binding LucroEstimadoTexto}" Margin="0,3,0,0" />
                </StackPanel>
            </Border>

            <Border Classes="kpi" Margin="8,0">
                <StackPanel>
                    <Border Classes="kpi-icon" Background="{DynamicResource PerigoSuaveBrush}" Margin="0,0,0,18">
                        <TextBlock Text="!" FontSize="21" FontWeight="Bold"
                                   Foreground="{DynamicResource PerigoBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Classes="kpi-label" Text="Stock Baixo" />
                    <TextBlock Classes="kpi-value" Foreground="{DynamicResource PerigoBrush}"
                               Text="{Binding StockBaixoTexto}" Margin="0,3,0,0" />
                </StackPanel>
            </Border>

            <Border Classes="kpi" Margin="8,0,0,0">
                <StackPanel>
                    <Border Classes="kpi-icon" Background="{DynamicResource NeutroSuaveBrush}" Margin="0,0,0,18">
                        <TextBlock Text="□" FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource TextoPrimarioBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Classes="kpi-label" Text="Vendas Realizadas" />
                    <TextBlock Classes="kpi-value" Text="{Binding VendasRealizadasTexto}" Margin="0,3,0,0" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Área analítica: tendência + alertas -->
        <Grid Grid.Row="3" RowDefinitions="Auto,Auto" ColumnDefinitions="2*,*" ColumnSpacing="24">

            <Border Grid.Column="0" Classes="painel" Padding="26">
                <StackPanel Spacing="18">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Tendência de Vendas" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextoPrimarioBrush}" />
                            <TextBlock Text="{Binding GraficoDescricao}" FontSize="12"
                                       Foreground="{DynamicResource TextoSecundarioBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button Content="7 Dias"
                                    Padding="12,6"
                                    Classes="secundario"
                                    Command="{Binding Selecionar7DiasCommand}" />
                            <Button Content="30 Dias"
                                    Padding="12,6"
                                    Classes="secundario"
                                    Command="{Binding Selecionar30DiasCommand}" />
                        </StackPanel>
                    </Grid>

                    <lvc:CartesianChart Height="250"
                                             Series="{Binding SeriesVendas}"
                                             XAxes="{Binding EixosXVendas}"
                                             YAxes="{Binding EixosYVendas}"
                                             AnimationsSpeed="00:00:00.250"
                                             LegendPosition="Hidden"
                                             TooltipPosition="Top"
                                             Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Classes="painel" Padding="24">
                <StackPanel Spacing="18">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="!" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource VerdePrimarioBrush}" />
                        <TextBlock Text="Alertas e Notificações" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextoPrimarioBrush}" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Alertas}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource PerigoSuaveBrush}"
                                        BorderBrush="{DynamicResource PerigoBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="14"
                                        Margin="0,0,0,10">
                                    <Grid ColumnDefinitions="42,*" ColumnSpacing="12">
                                        <Border Width="42" Height="42" CornerRadius="10"
                                                Background="{DynamicResource PerigoSuaveBrush}">
                                            <TextBlock Text="!" FontSize="18" FontWeight="Bold"
                                                       Foreground="{DynamicResource PerigoBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock Text="{Binding Titulo}" FontSize="12" FontWeight="Bold" />
                                            <TextBlock Text="{Binding Mensagem}" FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextoSecundarioBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Background="{DynamicResource NeutroSuaveBrush}"
                            BorderBrush="{DynamicResource BordaBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14"
                            IsVisible="{Binding SemAlertas}">
                        <TextBlock Text="Nenhum alerta pendente."
                                   FontSize="11"
                                   Foreground="{DynamicResource TextoSecundarioBrush}"
                                   HorizontalAlignment="Center" />
                    </Border>

                    <Button Classes="secundario"
                            Content="Ver Todos os Alertas"
                            HorizontalContentAlignment="Center"
                            Command="{Binding AbrirAlertasCommand}" />
                </StackPanel>
            </Border>

        </Grid>
                    <Border Grid.Row="1" Background="{DynamicResource NeutroSuaveBrush}" CornerRadius="10" Padding="18">
                        <TextBlock Text="O histórico detalhado de vendas será ligado aos dados reais nesta etapa."
                                   FontSize="12" Foreground="{DynamicResource TextoSecundarioBrush}"
                                   HorizontalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Popup/modal de alertas -->
        <Border Grid.RowSpan="4"
                ZIndex="100"
                Background="#66000000"
                IsVisible="{Binding AlertasPopupAberto}"
                Padding="40">
            <Border Background="{DynamicResource SuperficieBrush}"
                    BorderBrush="{DynamicResource BordaBrush}"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="26"
                    MaxWidth="620"
                    MaxHeight="600"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BoxShadow="0 18 40 0 #33000000">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="18">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Todos os Alertas" FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource TextoPrimarioBrush}" />
                            <TextBlock Text="{Binding Alertas.Count, StringFormat='Pendentes: {0}'}"
                                       FontSize="12" Foreground="{DynamicResource TextoSecundarioBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Classes="secundario"
                                Width="38" Height="38" Padding="0"
                                Command="{Binding FecharAlertasCommand}" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Alertas}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource NeutroSuaveBrush}"
                                            BorderBrush="{DynamicResource BordaBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="14"
                                            Margin="0,0,0,10">
                                        <Grid ColumnDefinitions="42,*,Auto" ColumnSpacing="12">
                                            <Border Width="42" Height="42" CornerRadius="10"
                                                    Background="{DynamicResource PerigoSuaveBrush}">
                                                <TextBlock Text="!" FontSize="18" FontWeight="Bold"
                                                           Foreground="{DynamicResource PerigoBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="3">
                                                <TextBlock Text="{Binding Titulo}" FontSize="12" FontWeight="Bold" />
                                                <TextBlock Text="{Binding Mensagem}" FontSize="11"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextoSecundarioBrush}" />
                                            </StackPanel>
                                            <Button Grid.Column="2"
                                                    Content="Eliminar"
                                                    Classes="perigo"
                                                    Padding="10,6"
                                                    Command="{Binding $parent[UserControl].DataContext.RemoverAlertaCommand}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                        <Button Classes="secundario" Content="Fechar" Command="{Binding FecharAlertasCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
