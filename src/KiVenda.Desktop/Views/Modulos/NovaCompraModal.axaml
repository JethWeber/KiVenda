<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmm="using:KiVenda.Desktop.ViewModels.Modulos"
             xmlns:fornecedores="using:KiVenda.Application.Fornecedores"
             xmlns:produtos="using:KiVenda.Application.Produtos"
             x:Class="KiVenda.Desktop.Views.Modulos.NovaCompraModal"
             x:DataType="vmm:ComprasViewModel">

    <UserControl.Styles>
        <Style Selector="Button.fechar-modal">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource NeutroSuaveBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextoSecundarioBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Styles>

    <Grid x:Name="Overlay"
          IsVisible="{Binding FormularioAberto}"
          Background="#66000000"
          KeyDown="OnKeyDown">

        <Border Classes="cartao" Width="600" MaxHeight="720"
                HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
            <StackPanel Spacing="18">

                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                    <StackPanel Spacing="3">
                        <TextBlock Text="Nova Compra" FontSize="20" FontWeight="Bold" />
                        <TextBlock Classes="subtitulo" Text="A entrada será refletida no stock automaticamente." />
                    </StackPanel>
                    <Border Grid.Column="1" Classes="badge badge-neutro" VerticalAlignment="Top">
                        <TextBlock Text="ENTRADA DE STOCK" FontSize="10" FontWeight="Bold" />
                    </Border>
                    <Button Grid.Column="2" Classes="fechar-modal" Content="×"
                            VerticalAlignment="Top"
                            Command="{Binding FecharFormularioCommand}" />
                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="14" RowDefinitions="Auto,Auto" RowSpacing="14">
                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                        <TextBlock Classes="rotulo-campo" Text="Fornecedor" />
                        <ComboBox x:Name="CampoPrincipal" HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding Fornecedores}"
                                  SelectedItem="{Binding FornecedorSelecionado}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="fornecedores:FornecedorDto">
                                    <TextBlock Text="{Binding Nome}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                        <TextBlock Classes="rotulo-campo" Text="Produto" />
                        <ComboBox HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding Produtos}"
                                  SelectedItem="{Binding ProdutoSelecionado}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="produtos:ProdutoDto">
                                    <TextBlock Text="{Binding Nome}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                        <TextBlock Classes="rotulo-campo" Text="Quantidade" />
                        <TextBox Text="{Binding Quantidade}" Watermark="ex.: 25" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                        <TextBlock Classes="rotulo-campo" Text="Custo total (Kz)" />
                        <TextBox Text="{Binding CustoTotal}" Watermark="ex.: 27500" />
                    </StackPanel>
                </Grid>

                <TextBlock Classes="erro" TextWrapping="Wrap"
                           Text="{Binding MensagemErroFormulario}"
                           IsVisible="{Binding MensagemErroFormulario, Converter={x:Static ObjectConverters.IsNotNull}}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                    <Button Content="Cancelar" Classes="secundario"
                            Command="{Binding FecharFormularioCommand}" />
                    <Button Content="Registar compra" Classes="primario"
                            Command="{Binding GuardarCommand}"
                            IsEnabled="{Binding !AGuardar}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
