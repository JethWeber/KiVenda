<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmm="using:KiVenda.Desktop.ViewModels.Modulos"
             xmlns:utilizadores="using:KiVenda.Application.Utilizadores"
             x:Class="KiVenda.Desktop.Views.Modulos.UtilizadoresView"
             x:DataType="vmm:UtilizadoresViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="20">

            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="3">
                    <TextBlock Classes="titulo-pagina" Text="Utilizadores" />
                    <TextBlock Classes="subtitulo" Text="Gerencie acessos e identifique quem realizou cada operação." />
                </StackPanel>
                <Button Grid.Column="1" Content="+ Novo Utilizador" Classes="primario"
                        Command="{Binding AbrirFormularioCommand}" />
            </Grid>

            <TextBlock Classes="erro" Text="{Binding MensagemErro}"
                       IsVisible="{Binding MensagemErro, Converter={x:Static ObjectConverters.IsNotNull}}" />

            <Border Classes="cartao" IsVisible="{Binding FormularioAberto}">
                <StackPanel Spacing="15">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Novo Utilizador" FontSize="18" FontWeight="Bold" />
                            <TextBlock Classes="subtitulo" Text="Crie um acesso e defina o perfil operacional." />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Cancelar" Classes="secundario"
                                Command="{Binding FecharFormularioCommand}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                        <StackPanel Spacing="5">
                            <TextBlock Classes="rotulo-campo" Text="Nome completo" />
                            <TextBox Text="{Binding NovoNome}" Watermark="ex.: João Manuel" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="5">
                            <TextBlock Classes="rotulo-campo" Text="Nome de utilizador" />
                            <TextBox Text="{Binding NovoNomeUtilizador}" Watermark="login" />
                        </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                        <StackPanel Spacing="5">
                            <TextBlock Classes="rotulo-campo" Text="Password inicial" />
                            <TextBox Text="{Binding NovaSenha}" PasswordChar="•" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="{StaticResource FundoPaginaBrush}"
                                BorderBrush="{StaticResource BordaBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="14">
                            <CheckBox Content="Utilizador com perfil Gerente"
                                      IsChecked="{Binding NovoPerfilGerente}" />
                        </Border>
                    </Grid>

                    <TextBlock Classes="erro" Text="{Binding MensagemErroFormulario}"
                               IsVisible="{Binding MensagemErroFormulario, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <Button Content="Criar utilizador" Classes="primario"
                            Command="{Binding GuardarCommand}" IsEnabled="{Binding !AGuardar}"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <Border Classes="cartao" Padding="0">
                <StackPanel>
                    <Grid ColumnDefinitions="1.6*,1.4*,1*,1*" Margin="20,17">
                        <TextBlock Text="NOME COMPLETO" Classes="subtitulo" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="UTILIZADOR" Classes="subtitulo" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="PERFIL" Classes="subtitulo" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="ESTADO" Classes="subtitulo" FontWeight="SemiBold" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Itens}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="utilizadores:UtilizadorDto">
                                <Border BorderBrush="{StaticResource BordaBrush}" BorderThickness="0,1,0,0" Padding="20,14">
                                    <Grid ColumnDefinitions="1.6*,1.4*,1*,1*">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Id, StringFormat='ID: {0}'}" Classes="subtitulo" FontSize="10" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding NomeUtilizador}" Classes="subtitulo" VerticalAlignment="Center" />
                                        <Border Grid.Column="2" Classes="badge badge-neutro" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Perfil}" FontSize="11" />
                                        </Border>
                                        <Border Grid.Column="3" Classes="badge badge-sucesso" HorizontalAlignment="Left">
                                            <TextBlock Text="Ativo" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>