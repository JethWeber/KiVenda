<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="KiVenda.Desktop.Views.Dialogos.ConfirmarImpressaoWindow"
        Width="360"
        Height="180"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Title="Recibo">
    <StackPanel Margin="24" Spacing="20">
        <TextBlock Text="Imprimir recibo?"
                   FontSize="20"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center" />
        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
            <Button Grid.Column="0"
                    Content="NÃO"
                    Classes="secundario"
                    Click="Nao_Click" />
            <Button Grid.Column="1"
                    Content="SIM"
                    Classes="primario"
                    Click="Sim_Click" />
        </Grid>
    </StackPanel>
</Window>