<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:KiVenda.Desktop.Views.Dialogos"
        x:Class="KiVenda.Desktop.Views.Dialogos.ConfirmarImpressaoWindow"
        x:DataType="local:ConfirmarImpressaoWindow"
        Width="520" Height="720" MinWidth="420" MinHeight="500"
        CanResize="True" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Title="Pré-visualização do recibo">
    <Grid RowDefinitions="Auto,*,Auto" Margin="20" RowSpacing="16">
        <TextBlock Grid.Row="0" Text="Imprimir recibo?"
                   FontSize="20" FontWeight="SemiBold"
                   HorizontalAlignment="Center" />
        <Border Grid.Row="1" Background="#F7F7F7"
                BorderBrush="#D0D0D0" BorderThickness="1"
                CornerRadius="6" Padding="18">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding Preview}"
                           FontFamily="Courier New, monospace"
                           FontSize="12" LineHeight="15"
                           TextWrapping="NoWrap"
                           HorizontalAlignment="Center" />
            </ScrollViewer>
        </Border>
        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12">
            <Button Grid.Column="0" Content="NÃO"
                    Classes="secundario" Click="Nao_Click" />
            <Button Grid.Column="1" Content="SIM"
                    Classes="primario" Click="Sim_Click" />
        </Grid>
    </Grid>
</Window>