<Project Sdk="Microsoft.NET.Sdk">

  <!--
    KiVenda.Infrastructure
    Integrações técnicas dependentes do ambiente Desktop: impressora,
    leitura de código de barras, backup/restore e licenciamento.
    Implementa as interfaces definidas em KiVenda.Application.
    Implementação: ver Fase 4 (serviços) e Fase 8 (scanner) do plano.
  -->

  <ItemGroup>
    <ProjectReference Include="..\KiVenda.Core\KiVenda.Core.csproj" />
    <ProjectReference Include="..\KiVenda.Application\KiVenda.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Usado apenas pelo serviço de Backup (Fase 4), diretamente via ADO.NET
      (SqliteConnection.BackupDatabase), sem EF Core — a Infrastructure não
      referencia a Persistence (são camadas irmãs na arquitetura).
    -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />

    <!-- Mesmo override de segurança aplicado em KiVenda.Persistence.csproj
         (ver comentário lá para o porquê): CVE-2025-6965 / GHSA-2m69-gcr7-jv3q. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />

    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
  </ItemGroup>

</Project>
